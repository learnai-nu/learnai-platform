---
import SiteLayout from '../layouts/SiteLayout.astro';
import { companySizeLabels, companySizes } from '../lib/leads/business';
import { createServerSupabaseClient } from '../lib/supabase/server';
import '../styles/business-landing.css';

export const prerender = false;

const supabase = createServerSupabaseClient(Astro.request, Astro.cookies);

/** Tallene i "Platformen bag forløbet" skal komme fra det, der faktisk er publiceret. */
async function publishedCount(table: 'tools' | 'use_cases' | 'resources') {
	const { count } = await supabase
		.from(table)
		.select('id', { count: 'exact', head: true })
		.eq('published', true)
		.eq('locale', 'da');
	return count ?? 0;
}

const [toolCount, useCaseCount, resourceCount] = await Promise.all([
	publishedCount('tools'),
	publishedCount('use_cases'),
	publishedCount('resources'),
]);
/** Nul på tværs af alle tre betyder, at forespørgslen fejlede. Så viser vi dem ikke. */
const showStats = toolCount + useCaseCount + resourceCount > 0;

const status = Astro.url.searchParams.get('status');

const problems = [
	{
		title: 'Værktøjerne er købt — men de bliver ikke brugt',
		body: 'Licenserne til Copilot eller ChatGPT er på plads. Alligevel er det de samme få medarbejdere, der bruger dem, mens resten venter på, at nogen viser dem hvordan.',
	},
	{
		title: 'Alle vil gerne, ingen tør',
		body: 'Medarbejderne er usikre på, hvad de må lægge ind i et AI-værktøj. Uden klare spilleregler bliver forsigtighed hurtigt til stilstand.',
	},
	{
		title: 'Pilotprojektet døde stille',
		body: 'Der blev kørt et forsøg, og det virkede. Men da projektet sluttede, var der ingen til at bære det videre ud i resten af organisationen.',
	},
];

const steps = [
	{
		number: '01',
		title: 'Potentialeafdækning',
		body: 'Vi kortlægger processer, data og opgaver og finder de steder, hvor AI skaber målbar værdi — og lige så vigtigt: de steder, hvor den ikke gør.',
	},
	{
		number: '02',
		title: 'Rådgivning og strategi',
		body: 'Use cases prioriteres efter værdi og risiko. I får en realistisk roadmap med milepæle, succeskriterier og styr på sikkerhed og GDPR fra dag ét.',
	},
	{
		number: '03',
		title: 'Workshops',
		body: 'Hands-on sessioner, hvor medarbejderne arbejder med AI på deres egne, konkrete opgaver. Læringen sidder fast, fordi den er relevant fra første dag.',
	},
	{
		number: '04',
		title: 'Kurser og kompetenceudvikling',
		body: 'Kompetenceopbygning i niveauer — fælles, teamspecifik og individuel — samt uddannelse af interne AI-ambassadører, der bærer udviklingen videre.',
	},
	{
		number: '05',
		title: 'Forankring og ansvarlig drift',
		body: 'Retningslinjer, politikker og KPI\'er, der gør AI til en tryg og blivende driftsdisciplin — ikke et engangsprojekt.',
	},
];

/** Tallene er fra TEKNIQ, hvor Jesper selv har stået for indsatsen. Det skal
    fremgå af siden, så de ikke læses som resultater hos en kunde. */
const proof = [
	{ value: '84 %', label: 'bruger AI dagligt' },
	{ value: '95 %', label: 'føler sig kompetente' },
	{ value: '100', label: 'medarbejdere trænet' },
	{ value: '12', label: 'AI-ambassadører uddannet' },
];

const results = [
	{
		featured: true,
		tag: 'Uafhængigt dokumenteret · 2026',
		title: 'Effekten er målt udefra',
		body: 'Et CBS-speciale har vurderet TEKNIQs AI-forankring op mod forskningens kriterier og bedømmer både den strategiske forankring og medarbejderaccepten som “meget stærk”: 84 % bruger AI dagligt, og 95 % føler sig kompetente i deres brug. Resultaterne er også fremhævet i den adm. direktørs bog om ledelse og AI.',
	},
	{
		tag: 'Kompetencer',
		title: 'Kompetenceløft på tre niveauer',
		body: '100 medarbejdere trænet i generelle AI-kompetencer, teamspecifikke forløb for 10 teams og individuel opbygning — båret videre af 12 interne AI-ambassadører.',
	},
	{
		tag: 'Chatbot',
		title: 'KVIQ i ny generation',
		body: 'Chatbotten er opgraderet til en ny generation med markant bedre svar og væsentligt lavere driftsomkostninger end den tidligere løsning.',
	},
	{
		tag: 'Tale-til-tekst',
		title: 'Fra telefonsamtaler til indsigt',
		body: 'Automatiske referater af telefonsamtaler bruges til at analysere, hvad medlemmerne ringer om. Trends og afvigelser opfanges, og nyhedsbreve genereres på baggrund af dem.',
	},
	{
		tag: 'Voicebot · 2026',
		title: 'Telefonen tages — også efter lukketid',
		body: 'En voicebot er under opbygning. Den besvarer i første omgang opkald uden for åbningstid, så ingen møder en tavs linje.',
	},
	{
		tag: 'Næste skridt',
		title: 'Agenter, der udfører opgaver',
		body: 'AI-agenter, der løser konkrete opgaver — og på sigt hele teams af agenter: human-led, agent-operated teams.',
	},
];

const deliverables = [
	{ title: 'Prioriteret mulighedsliste', body: 'De processer og opgaver, hvor AI betaler sig hos jer — rangeret efter værdi og risiko.' },
	{ title: 'Roadmap med milepæle', body: 'Hvad der sker hvornår, hvem der ejer det, og hvad succes ser ud som.' },
	{ title: 'Spilleregler for data', body: 'Retningslinjer og politikker for, hvad medarbejderne må dele med et AI-værktøj — og hvad de aldrig må.' },
	{ title: 'Promptbibliotek', body: 'Færdige, afprøvede prompts til jeres tilbagevendende opgaver. Skrevet på dansk.' },
	{ title: 'Trænet ambassadørkorps', body: 'De kolleger, resten spørger, når forløbet er slut. Uddannet efter train-the-trainer-princippet.' },
	{ title: 'KPI\'er på faktisk brug', body: 'Vi måler på anvendelse og oplevet værdi — ikke på antal licenser.' },
];

const questions = [
	{
		question: 'Hvad koster et forløb?',
		answer: 'Prisen afhænger af omfang og antal medarbejdere. Skriv til mig med jeres situation, så får I et konkret oplæg frem for en standardpakke.',
	},
	{
		question: 'Hvad er AI-adoption egentlig?',
		answer: 'Det er processen med at få AI-værktøjer i reel, daglig brug — ikke bare at indkøbe teknologien. Det kræver kompetenceopbygning, klare retningslinjer og forankring i medarbejdernes egne opgaver.',
	},
	{
		question: 'Kan effekten måles?',
		answer: 'Ja, og den skal måles på faktisk anvendelse og oplevet værdi frem for antal licenser. Hos TEKNIQ er forankringen vurderet uafhængigt i et CBS-speciale fra 2026: 84 % bruger AI dagligt, og 95 % føler sig kompetente i deres brug.',
	},
	{
		question: 'Hvad er et AI-ambassadørkorps?',
		answer: 'En gruppe medarbejdere, der uddannes som interne superbrugere og forandringsagenter. De hjælper kollegerne i gang, så fremdriften ikke afhænger af eksterne konsulenter, når forløbet er slut.',
	},
	{
		question: 'Skal vi bruge bestemte AI-værktøjer?',
		answer: 'Nej. Forløbet tager udgangspunkt i det, I allerede har godkendt — ofte Microsoft Copilot. Har I ikke valgt endnu, hjælper jeg med at afklare det.',
	},
	{
		question: 'Hvordan håndterer I data og GDPR?',
		answer: 'Sikkerhed og GDPR er med fra dag ét, ikke som et bilag til sidst. Øvelserne bygges, så medarbejderne kan træne uden at dele person- eller kundedata, og forløbet slutter med retningslinjer, I kan drive videre på.',
	},
	{
		question: 'Kan I køre det for hele organisationen på én gang?',
		answer: 'Vi starter typisk med en afgrænset gruppe, hvor effekten er nem at se, og bruger den som løftestang til resten. Det giver hurtigere resultater end en samlet udrulning.',
	},
	{
		question: 'Vi vil gerne prøve noget først. Kan vi det?',
		answer: 'Ja. Tag det gratis minikursus “AI i praksis”. Det tager cirka en time og giver jer et fælles udgangspunkt, inden vi taler sammen.',
	},
];

const title = 'AI-forløb for virksomheder';
const description = 'Fra AI-nysgerrighed til daglig brug: potentialeafdækning, kompetenceløft og forankring. Metoden har givet 84 % daglig AI-brug hos TEKNIQ, dokumenteret i et CBS-speciale.';

const personSchema = {
	'@type': 'Person',
	name: 'Jesper Gunris Schneider',
	url: 'https://jesperschneider.dk/',
	jobTitle: 'Chef for Digital Forretningsudvikling',
	worksFor: { '@type': 'Organization', name: 'TEKNIQ', url: 'https://www.tekniq.dk/' },
	sameAs: ['https://www.linkedin.com/in/jesperschneider/', 'https://jesperschneider.dk/'],
};
const faqSchema = {
	'@type': 'FAQPage',
	mainEntity: questions.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: { '@type': 'Answer', text: item.answer },
	})),
};
---

<SiteLayout
	title={`${title} — LearnAI.nu`}
	{description}
	pageType="WebPage"
	breadcrumbs={[
		{ name: 'Forside', url: '/' },
		{ name: 'For virksomheder', url: '/virksomheder' },
	]}
	additionalSchema={[personSchema, faqSchema]}
>
	<div class="business-landing">
		<section class="business-hero business-shell">
			<div class="business-hero-copy">
				<p class="business-eyebrow"><span class="business-dot"></span> For virksomheder</p>
				<h1>AI bliver først værdifuldt, når medarbejderne bruger det <span>om mandagen</span>.</h1>
				<p class="business-lead">
					Jeg hjælper virksomheder med at gå fra AI-nysgerrighed til AI-vaner: en klar prioritering af, hvor
					det betaler sig, et kompetenceløft der rammer den faktiske hverdag, og et ambassadørkorps der
					holder det i live, når forløbet er slut.
				</p>
				<div class="business-hero-actions">
					<a class="business-button" href="#kontakt">Book en uforpligtende snak <span aria-hidden="true">→</span></a>
					<a class="business-text-link" href="/kurser/ai-i-praksis">Prøv det gratis kursus først <span aria-hidden="true">→</span></a>
				</div>
				<ul class="business-hero-meta">
					<li>Undervisning på dansk</li>
					<li>Værktøjsneutralt</li>
					<li>Øvelser fra jeres egne opgaver</li>
				</ul>
			</div>
			<aside class="business-hero-card" aria-label="Dokumenteret effekt">
				<p class="business-card-label">Dokumenteret effekt</p>
				<dl class="business-proof">
					{proof.map((item) => (
						<div>
							<dt>{item.value}</dt>
							<dd>{item.label}</dd>
						</div>
					))}
				</dl>
				<p class="business-card-footer">
					Tallene er fra TEKNIQ, hvor jeg selv har stået for indsatsen. Forankringen er vurderet
					uafhængigt i et CBS-speciale fra 2026.
				</p>
			</aside>
		</section>

		<section class="business-section business-shell" aria-labelledby="problem-title">
			<div class="business-section-heading">
				<h2 id="problem-title">Det er sjældent teknologien, der er problemet</h2>
				<p>De fleste virksomheder er ikke stoppet af manglende værktøjer. De er stoppet af tre ting, der ligner hinanden på tværs af brancher.</p>
			</div>
			<div class="business-grid business-grid-3">
				{problems.map((problem) => (
					<article class="business-card">
						<h3>{problem.title}</h3>
						<p>{problem.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="business-section business-shell" aria-labelledby="forloeb-title">
			<div class="business-section-heading">
				<h2 id="forloeb-title">AI-adoption i fem trin</h2>
				<p>Adoption sker ikke i et slideshow. Forløbet tilpasses jeres situation, men rækkefølgen er den samme — fra potentiale til varig forankring, med mennesker i centrum hele vejen.</p>
			</div>
			<ol class="business-phases">
				{steps.map((step) => (
					<li class="business-phase">
						<p class="business-phase-number">{step.number}</p>
						<div>
							<h3>{step.title}</h3>
							<p>{step.body}</p>
						</div>
					</li>
				))}
			</ol>
			<p class="business-model-note">
				Logikken er enkel: vi bygger AI-kompetencer først og veksler dem derefter til værdi og varig
				konkurrencefordel.
			</p>
		</section>

		<section class="business-section business-shell" aria-labelledby="leverance-title">
			<div class="business-section-heading">
				<h2 id="leverance-title">Det får I med hjem</h2>
				<p>Konkrete ting, der bliver i organisationen — også når jeg er ude af døren.</p>
			</div>
			<div class="business-grid business-grid-3">
				{deliverables.map((item) => (
					<article class="business-card business-card-tight">
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="business-section business-shell" aria-labelledby="resultat-title">
			<div class="business-section-heading">
				<h2 id="resultat-title">Hvad metoden har givet</h2>
				<p>Resultaterne herunder er fra TEKNIQ, hvor jeg selv har stået for indsatsen. Det er ikke kundecases — det er den metode, I får.</p>
			</div>
			<div class="business-results">
				{results.map((item) => (
					<article class={item.featured ? 'business-result business-result-featured' : 'business-result'}>
						<p class="business-result-tag">{item.tag}</p>
						<h3>{item.title}</h3>
						<p>{item.body}</p>
					</article>
				))}
			</div>
		</section>

		<section class="business-section business-shell" aria-labelledby="afsender-title">
			<div class="business-author">
				<div>
					<p class="business-eyebrow"><span class="business-dot"></span> Afsender</p>
					<h2 id="afsender-title">Hvem står bag</h2>
					<p>
						Jeg hedder <strong>Jesper Gunris Schneider</strong> og er chef for digital
						forretningsudvikling i TEKNIQ. Jeg leder et tværfagligt digitalt team og har ansvaret for
						AI-strategi og for, at teknologien rent faktisk bliver brugt bredt — ikke kun af de nysgerrige.
					</p>
					<p>
						Jeg har arbejdet med digital forretning i mere end 25 år: e-commerce, telecom og nu
						AI-transformation. Jeg ser AI som et redskab til at styrke beslutninger, effektivisere
						processer og skabe bedre oplevelser — ikke som et mål i sig selv. Det er også sådan,
						forløbene er skruet sammen.
					</p>
					<p class="business-author-link">
						<a href="https://jesperschneider.dk/" target="_blank" rel="noopener noreferrer">
							Læs mere om mig <span aria-hidden="true">↗</span>
						</a>
						<a href="https://www.linkedin.com/in/jesperschneider/" target="_blank" rel="noopener noreferrer">
							LinkedIn <span aria-hidden="true">↗</span>
						</a>
					</p>
				</div>
				<dl class="business-stats">
					{showStats && (
						<>
							<div>
								<dt>Værktøjer i kataloget</dt>
								<dd>{toolCount}</dd>
							</div>
							<div>
								<dt>Use cases fra praksis</dt>
								<dd>{useCaseCount}</dd>
							</div>
							<div>
								<dt>Kuraterede ressourcer</dt>
								<dd>{resourceCount}</dd>
							</div>
						</>
					)}
					<div class="business-stats-note">
						<dt>Platformen bag forløbet</dt>
						<dd>Deltagerne får adgang til LearnAI med kurser, værktøjskatalog og use cases, så de kan slå op og træne videre efter forløbet.</dd>
					</div>
				</dl>
			</div>
		</section>

		<section class="business-section business-shell" aria-labelledby="faq-title">
			<div class="business-section-heading">
				<h2 id="faq-title">Spørgsmål, jeg får hver gang</h2>
				<p>Er der noget, der ikke står her, så skriv det i formularen nedenfor.</p>
			</div>
			<div class="business-faq">
				{questions.map((item) => (
					<details>
						<summary>
							{item.question}
							<span aria-hidden="true">+</span>
						</summary>
						<p>{item.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section class="business-contact" id="kontakt" aria-labelledby="kontakt-title">
			<div class="business-shell business-contact-inner">
				<div class="business-contact-copy">
					<p class="business-eyebrow"><span class="business-dot"></span> Næste skridt</p>
					<h2 id="kontakt-title">Fortæl mig, hvor I står</h2>
					<p>
						Udfyld formularen, så vender jeg tilbage med et forslag til en samtale på 30 minutter. Ingen
						præsentation, ingen forpligtelse — vi finder ud af, om der er et forløb at lave.
					</p>
					<ul class="business-contact-points">
						<li>Svar inden for to hverdage</li>
						<li>Oplysningerne bruges kun til at kontakte jer</li>
						<li>Du kan altid bede mig slette dem igen</li>
					</ul>
				</div>

				<div class="business-form-card">
					{status === 'success' && (
						<p class="business-notice business-notice-success" role="status">
							Tak. Jeg har modtaget din henvendelse og vender tilbage inden for to hverdage.
						</p>
					)}
					{status === 'invalid' && (
						<p class="business-notice business-notice-error" role="alert">
							Noget mangler eller er udfyldt forkert. Kontrollér navn, arbejdsmail, virksomhed og samtykke.
						</p>
					)}
					{status === 'save-error' && (
						<p class="business-notice business-notice-error" role="alert">
							Henvendelsen kunne ikke gemmes lige nu. Prøv igen om lidt, eller skriv direkte til mig.
						</p>
					)}

					<form method="post" action="/api/leads/virksomheder" class="business-form">
						<div class="business-field">
							<label for="lead-name">Navn</label>
							<input id="lead-name" name="name" type="text" autocomplete="name" required maxlength="120" />
						</div>
						<div class="business-field">
							<label for="lead-email">Arbejdsmail</label>
							<input id="lead-email" name="email" type="email" autocomplete="email" required maxlength="254" />
						</div>
						<div class="business-field">
							<label for="lead-company">Virksomhed</label>
							<input id="lead-company" name="company" type="text" autocomplete="organization" required maxlength="160" />
						</div>
						<div class="business-field">
							<label for="lead-role">Rolle <span>(valgfrit)</span></label>
							<input id="lead-role" name="roleTitle" type="text" autocomplete="organization-title" maxlength="120" />
						</div>
						<div class="business-field">
							<label for="lead-size">Antal medarbejdere <span>(valgfrit)</span></label>
							<select id="lead-size" name="companySize">
								<option value="">Vælg…</option>
								{companySizes.map((size) => <option value={size}>{companySizeLabels[size]}</option>)}
							</select>
						</div>
						<div class="business-field business-field-wide">
							<label for="lead-goal">Hvad vil I gerne opnå? <span>(valgfrit)</span></label>
							<textarea id="lead-goal" name="goal" rows="4" maxlength="2000"
								placeholder="Fx: Vi har Copilot til 120 medarbejdere, men kun få bruger det."></textarea>
						</div>

						<p class="business-honeypot" aria-hidden="true">
							<label for="lead-website">Efterlad dette felt tomt</label>
							<input id="lead-website" name="website" type="text" tabindex="-1" autocomplete="off" />
						</p>

						<div class="business-field business-field-wide business-consent">
							<label for="lead-consent">
								<input id="lead-consent" name="consent" type="checkbox" value="yes" required />
								<span>Jeg accepterer, at LearnAI må kontakte mig om denne henvendelse. Se <a href="/privatliv">privatlivspolitikken</a>.</span>
							</label>
						</div>

						<div class="business-field-wide">
							<button class="business-button" type="submit">Send henvendelse <span aria-hidden="true">→</span></button>
						</div>
					</form>
				</div>
			</div>
		</section>
	</div>
</SiteLayout>
