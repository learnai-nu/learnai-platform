---
import SiteLayout from '../layouts/SiteLayout.astro';
import {
	buildFacet,
	label,
	searchIndex,
	toolBadgeLabels,
	toolCategoryLabels,
	tools,
} from '../lib/catalog';
import { createCanonicalUrl, createItemListSchema } from '../lib/seo/schema';
import '../styles/catalog.css';

export const prerender = true;

const categories = buildFacet(tools, (tool) => tool.categories, toolCategoryLabels);
const badges = buildFacet(tools, (tool) => tool.badges, toolBadgeLabels);
const sorted = [...tools].sort((a, b) => Number(b.featured) - Number(a.featured) || a.name.localeCompare(b.name, 'da'));
const canonicalUrl = createCanonicalUrl(Astro.url, Astro.site ? new URL(Astro.site) : Astro.url);
const itemList = createItemListSchema(
	canonicalUrl,
	sorted.map((tool) => ({ name: tool.name, url: tool.url ?? `/tools#${tool.slug}` })),
);
---

<SiteLayout
	title="AI-værktøjer — LearnAI.nu"
	description="Kurateret katalog over de AI-værktøjer, vi selv bruger: hvad de kan, hvad de koster, og hvornår de giver mening."
	pageType="CollectionPage"
	breadcrumbs={[
		{ name: 'Forside', url: '/' },
		{ name: 'Værktøjer', url: '/tools' },
	]}
	mainEntity={itemList}
>
	<div class="catalog-page" data-catalog>
		<section class="catalog-head">
			<div class="catalog-shell">
				<p class="catalog-eyebrow">Værktøjskatalog</p>
				<h1>AI-værktøjer, testet og udvalgt.</h1>
				<p>En kurateret oversigt over de værktøjer, vi rent faktisk bruger — fra det daglige arbejde til de mere specialiserede opgaver. Filtrér efter opgave, og find det værktøj, der passer til dit næste skridt.</p>
			</div>
		</section>

		<section class="catalog-controls" aria-label="Filtrér værktøjer">
			<div class="catalog-shell">
				<label class="orbit-eyebrow" for="tool-search">Søg</label>
				<input
					id="tool-search"
					class="catalog-search"
					type="search"
					placeholder="Søg efter værktøj, opgave eller funktion"
					data-catalog-search
				/>
				<div class="catalog-facets">
					<div class="catalog-facet-row">
						<p class="catalog-facet-label" id="tool-category-label">Kategori</p>
						<div role="group" aria-labelledby="tool-category-label">
							<button class="catalog-chip" type="button" data-facet="category" data-value="" aria-pressed="true">Alle</button>
							{categories.map((option) => (
								<button class="catalog-chip" type="button" data-facet="category" data-value={option.value} aria-pressed="false">
									{option.label}<span class="catalog-chip-count">{option.count}</span>
								</button>
							))}
						</div>
					</div>
					<div class="catalog-facet-row">
						<p class="catalog-facet-label" id="tool-badge-label">Mærkat</p>
						<div role="group" aria-labelledby="tool-badge-label">
							<button class="catalog-chip" type="button" data-facet="badge" data-value="" aria-pressed="true">Alle</button>
							{badges.map((option) => (
								<button class="catalog-chip" type="button" data-facet="badge" data-value={option.value} aria-pressed="false">
									{option.label}<span class="catalog-chip-count">{option.count}</span>
								</button>
							))}
						</div>
					</div>
				</div>
				<p class="catalog-count" data-catalog-count data-noun="værktøjer">{sorted.length} værktøjer</p>
			</div>
		</section>

		<div class="catalog-shell">
			<div class="catalog-grid">
				{sorted.map((tool) => (
					<article
						class:list={['catalog-card', tool.featured && 'catalog-card-featured']}
						id={tool.slug}
						data-catalog-item
						data-facet-category={tool.categories.join(' ')}
						data-facet-badge={tool.badges.join(' ')}
						data-search={searchIndex(tool.name, tool.tagline, tool.description, tool.keyFeatures, tool.categories.map((value) => label(toolCategoryLabels, value)))}
					>
						<div class="catalog-card-head">
							{tool.iconUrl && <img class="catalog-card-icon" src={tool.iconUrl} alt="" loading="lazy" decoding="async" width="36" height="36" />}
							<h2>{tool.name}</h2>
						</div>
						{tool.badges.length > 0 && (
							<ul class="catalog-tags">
								{tool.badges.map((badge) => (
									<li class="catalog-tag catalog-tag-accent">{label(toolBadgeLabels, badge)}</li>
								))}
							</ul>
						)}
						<p class="catalog-card-lead">{tool.tagline}</p>
						<p>{tool.description}</p>
						{tool.keyFeatures.length > 0 && (
							<ul class="catalog-list">
								{tool.keyFeatures.map((feature) => <li>{feature}</li>)}
							</ul>
						)}
						<ul class="catalog-tags">
							{tool.categories.map((category) => (
								<li class="catalog-tag">{label(toolCategoryLabels, category)}</li>
							))}
						</ul>
						<div class="catalog-card-footer">
							{tool.pricing && <p class="catalog-price">{tool.pricing}</p>}
							{tool.url && (
								<a class="catalog-link" href={tool.url} target="_blank" rel="noopener noreferrer">
									Besøg {tool.name} <span aria-hidden="true">→</span>
								</a>
							)}
						</div>
					</article>
				))}
			</div>
			<p class="catalog-empty" data-catalog-empty hidden>Ingen værktøjer matcher din søgning. Prøv en anden kategori eller et andet søgeord.</p>
		</div>
	</div>
</SiteLayout>

<script>
	import '../scripts/catalog-filter';
</script>
