---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { label, resourceTypeLabels } from '../../../lib/catalog';
import { adminEmail, getAdminContext } from '../../../lib/auth/admin';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');

const context = await getAdminContext(Astro.request, Astro.cookies);
if (!context.claims) {
	return new Response(null, { status: 302, headers: { Location: '/login?status=required' } });
}
if (!context.role) return new Response('Du har ikke adgang til administrationen.', { status: 403 });

const { data: items, error } = await context.supabase
	.from('resources')
	.select('id,slug,title,type,published,sort_order')
	.order('sort_order', { ascending: true });

const status = Astro.url.searchParams.get('status');
const statusMessages: Record<string, string> = {
	created: 'Ressourcen er oprettet som kladde.',
	saved: 'Ændringerne er gemt.',
};
---

<AdminLayout
	title="Ressourcer"
	description="Administrér ressourcerne på /resources."
	active="resources"
	email={adminEmail(context.claims)}
	role={context.role}
>
	<header class="admin-page-head">
		<div>
			<p class="eyebrow">Katalog</p>
			<h1>Ressourcer</h1>
			<p>Indholdet bag <a class="text-link" href="/resources">/resources</a>. Rækkefølgen styres af sorteringsnummeret.</p>
		</div>
		<a class="button" href="/admin/ressourcer/ny">Opret ressource</a>
	</header>

	{status && statusMessages[status] && <p class="notice" role="status">{statusMessages[status]}</p>}
	{status === 'error' && <p class="notice notice-error" role="alert">Ressourcen kunne ikke gemmes. Kontrollér felterne.</p>}

	<section class="admin-panel">
		{error ? (
			<p class="notice notice-error" role="alert">Listen kunne ikke hentes.</p>
		) : items?.length ? (
			<div class="admin-list">
				{items.map((item) => (
					<a href={`/admin/ressourcer/${item.id}`}>
						<span>
							<strong>{item.title}</strong>
							<small>#{item.sort_order} · {label(resourceTypeLabels, item.type)} · /{item.slug}</small>
						</span>
						<span class={`status-badge status-${item.published ? 'published' : 'draft'}`}>
							{item.published ? 'Publiceret' : 'Kladde'}
						</span>
					</a>
				))}
			</div>
		) : (
			<div class="admin-empty">
				<h2>Ingen ressourcer endnu</h2>
				<p>Opret den første ressource, eller kør katalogmigrationen.</p>
			</div>
		)}
	</section>
</AdminLayout>
