---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { eventLocationLabels, label } from '../../../lib/catalog';
import { adminEmail, getAdminContext } from '../../../lib/auth/admin';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');

const context = await getAdminContext(Astro.request, Astro.cookies);
if (!context.claims) {
	return new Response(null, { status: 302, headers: { Location: '/login?status=required' } });
}
if (!context.role) return new Response('Du har ikke adgang til administrationen.', { status: 403 });

const { data: items, error } = await context.supabase
	.from('events')
	.select('id,slug,title,event_date,location_type,location_name,published,locale')
	.order('event_date', { ascending: false });

const status = Astro.url.searchParams.get('status');
const statusMessages: Record<string, string> = {
	created: 'Eventet er oprettet som kladde.',
	saved: 'Ændringerne er gemt.',
};
const dateFormat = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'short', year: 'numeric' });
---

<AdminLayout
	title="Events"
	description="Administrér events på /events."
	active="events"
	email={adminEmail(context.claims)}
	role={context.role}
>
	<header class="admin-page-head">
		<div>
			<p class="eyebrow">Katalog</p>
			<h1>Events</h1>
			<p>Indholdet bag <a class="text-link" href="/events">/events</a>. Datoen bestemmer, om et event står under kommende eller tidligere.</p>
		</div>
		<a class="button" href="/admin/events/ny">Opret event</a>
	</header>

	{status && statusMessages[status] && <p class="notice" role="status">{statusMessages[status]}</p>}
	{status === 'error' && <p class="notice notice-error" role="alert">Eventet kunne ikke gemmes. Kontrollér felterne.</p>}

	<section class="admin-panel">
		{error ? (
			<p class="notice notice-error" role="alert">Listen kunne ikke hentes.</p>
		) : items?.length ? (
			<div class="admin-list">
				{items.map((item) => (
					<a href={`/admin/events/${item.id}`}>
						<span>
							<strong>{item.title}</strong>
							<small>
								{item.locale === 'en' ? 'EN' : 'DA'} · {dateFormat.format(new Date(item.event_date))}
								· {label(eventLocationLabels, item.location_type)}
								{item.location_name ? ` · ${item.location_name}` : ''}
							</small>
						</span>
						<span class={`status-badge status-${item.published ? 'published' : 'draft'}`}>
							{item.published ? 'Publiceret' : 'Kladde'}
						</span>
					</a>
				))}
			</div>
		) : (
			<div class="admin-empty">
				<h2>Ingen events endnu</h2>
				<p>Opret det første event, eller kør katalogmigrationen.</p>
			</div>
		)}
	</section>
</AdminLayout>
