---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { eventLocationLabels } from '../../../lib/catalog';
import { adminEmail, getAdminContext } from '../../../lib/auth/admin';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');

const context = await getAdminContext(Astro.request, Astro.cookies);
if (!context.claims) {
	return new Response(null, { status: 302, headers: { Location: '/login?status=required' } });
}
if (!context.role) return new Response('Du har ikke adgang til administrationen.', { status: 403 });

interface EventRow {
	id: string;
	slug: string;
	title: string;
	description: string | null;
	event_date: string;
	time_start: string | null;
	time_end: string | null;
	location_type: string;
	location_name: string | null;
	registration_url: string | null;
	organizer: string | null;
	price: string | null;
	published: boolean;
	locale: string;
	sort_order: number;
}

const isNew = Astro.params.id === 'ny';
let item: EventRow | null = null;

if (!isNew) {
	const result = await context.supabase
		.from('events')
		.select('id,slug,title,description,event_date,time_start,time_end,location_type,location_name,registration_url,organizer,price,published,locale,sort_order')
		.eq('id', Astro.params.id)
		.maybeSingle();
	if (result.error || !result.data) return new Response('Eventet blev ikke fundet.', { status: 404 });
	item = result.data;
}

const status = Astro.url.searchParams.get('status');
/** The date input needs a plain YYYY-MM-DD value, not the stored timestamp. */
const dateValue = item ? new Date(item.event_date).toISOString().slice(0, 10) : '';
---

<AdminLayout
	title={isNew ? 'Nyt event' : item?.title ?? 'Redigér event'}
	description="Redigér et event i kalenderen."
	active="events"
	email={adminEmail(context.claims)}
	role={context.role}
>
	<header class="admin-page-head">
		<div>
			<a class="admin-back" href="/admin/events">← Events</a>
			<h1>{isNew ? 'Opret event' : 'Redigér event'}</h1>
			<p>Nye events oprettes som kladde og bliver først synlige, når de publiceres.</p>
		</div>
		{item?.published && <a class="button button-ghost" href={`${item.locale === 'en' ? '/en/events' : '/events'}#${item.slug}`}>Se på sitet</a>}
	</header>

	{status === 'created' && <p class="notice" role="status">Eventet er oprettet som kladde.</p>}
	{status === 'error' && <p class="notice notice-error" role="alert">Eventet kunne ikke gemmes. Kontrollér felterne og sluggen.</p>}

	<form class="admin-form" method="post" action="/api/admin/catalog/save">
		<input type="hidden" name="catalog" value="event" />
		<input type="hidden" name="id" value={item?.id ?? ''} />
		<div class="admin-form-grid">
			<label class="field-wide">
				Titel
				<input name="title" required maxlength="200" value={item?.title ?? ''} />
			</label>
			<label>
				Slug
				<input name="slug" required maxlength="160" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" value={item?.slug ?? ''} />
			</label>
			<label>
				Sortering
				<input name="sortOrder" type="number" min="0" max="10000" value={item?.sort_order ?? 0} />
			</label>
			<label>
				Sprog
				<select name="locale">
					<option value="da" selected={item?.locale !== 'en'}>Dansk</option>
					<option value="en" selected={item?.locale === 'en'}>Engelsk</option>
				</select>
				<small>Sproget bestemmer, om rækken vises på de danske eller engelske sider.</small>
			</label>
			<label>
				Dato
				<input name="eventDate" type="date" required value={dateValue} />
			</label>
			<label>
				Starttidspunkt
				<input name="timeStart" maxlength="20" placeholder="18:00" value={item?.time_start ?? ''} />
			</label>
			<label>
				Sluttidspunkt
				<input name="timeEnd" maxlength="20" placeholder="23:00" value={item?.time_end ?? ''} />
			</label>
			<label>
				Form
				<select name="locationType">
					{Object.entries(eventLocationLabels).map(([value, text]) => (
						<option value={value} selected={item?.location_type === value}>{text}</option>
					))}
				</select>
			</label>
			<label>
				Sted
				<input name="locationName" maxlength="200" value={item?.location_name ?? ''} />
			</label>
			<label class="field-wide">
				Beskrivelse
				<textarea name="description" rows="5" maxlength="4000">{item?.description ?? ''}</textarea>
			</label>
			<label>
				Tilmeldingslink
				<input name="registrationUrl" type="url" maxlength="500" value={item?.registration_url ?? ''} />
			</label>
			<label>
				Arrangør
				<input name="organizer" maxlength="200" value={item?.organizer ?? ''} />
			</label>
			<label>
				Pris
				<input name="price" maxlength="100" value={item?.price ?? ''} />
			</label>
			<label>
				Status
				<select name="published">
					<option value="false" selected={!item?.published}>Kladde</option>
					<option value="true" selected={item?.published === true}>Publiceret</option>
				</select>
			</label>
		</div>
		<div class="admin-form-actions">
			<button class="button" type="submit">{isNew ? 'Opret som kladde' : 'Gem ændringer'}</button>
			<a class="button button-ghost" href="/admin/events">Annullér</a>
		</div>
	</form>
</AdminLayout>
