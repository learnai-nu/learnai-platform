---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminEmail, getAdminContext } from '../../lib/auth/admin';
import { courseParticipantsSchema, parseParticipantFilters, participantHref, participantProgress, participantStatusLabels } from '../../lib/admin/course-participants';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
const context = await getAdminContext(Astro.request, Astro.cookies);
if (!context.claims) return new Response(null, { status: 302, headers: { Location: '/login?status=required', 'Cache-Control': 'private, no-store, max-age=0' } });
if (context.role !== 'admin') return new Response('Du har ikke adgang til deltageroplysninger.', { status: 403, headers: { 'Cache-Control': 'private, no-store, max-age=0' } });

const filters = parseParticipantFilters(Astro.url.searchParams);
if (!filters.success) return new Response('Ugyldigt filter. Gå tilbage til /admin/deltagere.', { status: 400, headers: { 'Cache-Control': 'private, no-store, max-age=0' } });
const { course, status, q, page } = filters.data;
const [result, coursesResult] = await Promise.all([
	context.supabase.rpc('admin_course_participants', { p_course_id: course || null, p_status: status, p_search: q, p_page: page }),
	context.supabase.from('courses').select('id,title').order('title'),
]);
const parsed = courseParticipantsSchema.safeParse(result.data);
const participants = !result.error && parsed.success ? parsed.data : null;
const selectedCourse = coursesResult.data?.find((item) => item.id === course);
if (course && !coursesResult.error && !selectedCourse) return new Response('Kurset blev ikke fundet.', { status: 404, headers: { 'Cache-Control': 'private, no-store, max-age=0' } });
const date = new Intl.DateTimeFormat('da-DK', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Copenhagen' });
const formatDate = (value: string | null) => value ? date.format(new Date(value)) : '—';
const pages = participants ? Math.max(1, Math.ceil(participants.total / participants.pageSize)) : 1;
---

<AdminLayout title="Deltagere" description="Deltagere og fremskridt på LearnAI-kurser." active="participants" email={adminEmail(context.claims)} role={context.role}>
	<header class="admin-page-head">
		<div>
			<p class="eyebrow">Kursusaktivitet</p><h1>Deltagere og fremskridt</h1>
			<p>{selectedCourse?.title ?? 'Alle kurser'} · {participantStatusLabels[status]}</p>
		</div>
		<div class="admin-actions">
			<a class="button button-ghost" href="/admin/kurser">Til kursusoversigten</a>
			{selectedCourse && <a class="text-link" href={`/admin/kurser/${selectedCourse.id}`}>Rediger kursus →</a>}
		</div>
	</header>

	<form method="get" action="/admin/deltagere" class="admin-panel participant-filters">
		<label>Kursus<select name="course"><option value="">Alle kurser</option>{coursesResult.data?.map((item) => <option value={item.id} selected={course === item.id}>{item.title}</option>)}</select></label>
		<label>Status<select name="status">{Object.entries(participantStatusLabels).map(([value, label]) => <option value={value} selected={status === value}>{label}</option>)}</select></label>
		<label>Navn eller e-mail<input name="q" type="search" value={q} maxlength="100" placeholder="Find en deltager" /></label>
		<button class="button" type="submit">Vis deltagere</button>
		<a class="text-link" href="/admin/deltagere">Nulstil</a>
	</form>
	{coursesResult.error && <p class="notice notice-error" role="alert">Kursusfilteret kunne ikke hentes. Genindlæs siden.</p>}
	<section class="admin-panel">
		{!participants ? (
			<p class="notice notice-error" role="alert">Deltagerne kunne ikke hentes. Genindlæs siden eller prøv igen om lidt.</p>
		) : (
			<>
				<div class="admin-panel-head"><div><h2>{participants.total} kursusforløb</h2><p>Hver række viser én deltager på ét kursus. Åbn “Se lektioner” for at se, hvor langt personen er kommet.</p></div></div>
				{participants.items.length === 0 ? (
					<div class="admin-empty"><p>{page > pages ? 'Denne side indeholder ingen deltagere.' : 'Ingen deltagere matcher de valgte filtre.'}</p><a class="text-link" href={participantHref(course)}>Se alle deltagere på {course ? 'kurset' : 'alle kurser'} →</a></div>
				) : (
					<div class="participant-table" role="region" aria-label="Deltagernes fremskridt" tabindex="0">
						<table>
							<caption>Navne, status og gemte fremskridt</caption>
							<thead><tr><th scope="col">Deltager</th><th scope="col">Kursus</th><th scope="col">Status</th><th scope="col">Fremskridt</th><th scope="col">Seneste aktivitet</th></tr></thead>
							<tbody>{participants.items.map((person) => (
								<tr>
									<th scope="row"><strong>{person.name ?? 'Navn ikke angivet'}</strong><small>{person.email ?? `Bruger ${person.userId}`}</small></th>
									<td>{person.courseTitle}<small>{person.enrolled ? `Tilmeldt ${formatDate(person.enrolledAt)}` : 'Uden registreret tilmelding'}</small></td>
									<td><span class="participant-status">{participantStatusLabels[person.status]}</span></td>
									<td>
										<strong>{participantProgress(person.completedCount, person.lessonCount)} %</strong><small>{person.completedCount} af {person.lessonCount} lektioner fuldført</small>
										<progress max={person.lessonCount || 1} value={person.completedCount} aria-label={`Fremskridt for ${person.name ?? person.email ?? 'deltager'} på ${person.courseTitle}`} />
										<details><summary>Se lektioner</summary><ol>{person.lessons.map((lesson) => <li><strong>{lesson.title}</strong><small>{lesson.moduleTitle} · {lesson.completed ? 'Fuldført' : lesson.started ? 'I gang' : 'Ikke startet'}</small></li>)}</ol>{person.lessons.length === 0 && <p>Kurset har endnu ingen lektioner.</p>}</details>
									</td>
									<td>{formatDate(person.lastActivity)}</td>
								</tr>
							))}</tbody>
						</table>
					</div>
				)}
				<nav class="participant-pagination" aria-label="Sider med deltagere">
					{page > 1 && <a class="text-link" href={participantHref(course, status, q, page - 1)}>← Forrige</a>}
					<span>Side {page} af {pages}</span>
					{page < pages && <a class="text-link" href={participantHref(course, status, q, page + 1)}>Næste →</a>}
				</nav>
				<p class="participant-note">Fremskridt bygger på gemte lektionsmarkeringer. “Fuldført” kræver alle kursets nuværende lektioner. Personer uden registreret tilmelding vises også, når de har gemt fremskridt.</p>
			</>
		)}
	</section>
</AdminLayout>

<style>
	.participant-filters { display: flex; flex-wrap: wrap; align-items: end; gap: 1rem; margin-bottom: 1rem; }
	.participant-filters label { display: grid; gap: .4rem; flex: 1 1 12rem; min-width: 0; }
	input, select { width: 100%; min-width: 0; padding: .7rem; border: 1px solid var(--line); border-radius: .5rem; background: var(--surface); font: inherit; }
	.participant-table { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: .9rem; }
	caption { text-align: left; color: var(--muted); padding-bottom: 1rem; }
	th, td { padding: 1rem .7rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; min-width: 9rem; }
	tbody th { font-weight: 400; overflow-wrap: anywhere; }
	small { display: block; color: var(--muted); margin-top: .4rem; font-weight: 400; }
	progress { width: 100%; height: .65rem; accent-color: var(--accent); margin-top: .5rem; }
	details { margin-top: .6rem; min-width: 12rem; }
	summary { cursor: pointer; color: var(--accent); font-weight: 650; }
	ol { padding-left: 1.3rem; min-width: 18rem; }
	li { margin: .8rem 0; }
	.participant-status { font-weight: 650; white-space: nowrap; }
	.participant-pagination { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 1.5rem; margin-top: 1.5rem; }
	.participant-note { color: var(--muted); font-size: .85rem; line-height: 1.6; }
</style>
