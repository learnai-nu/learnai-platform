---
import SiteLayout from '../layouts/SiteLayout.astro';
import { createServerSupabaseClient } from '../lib/supabase/server';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');

const supabase = createServerSupabaseClient(Astro.request, Astro.cookies);
const { data: claimsData } = await supabase.auth.getClaims();
if (claimsData?.claims) {
	return new Response(null, {
		status: 302,
		headers: { Location: '/admin', 'Cache-Control': 'private, no-store, max-age=0' },
	});
}

const messages: Record<string, string> = {
	invalid: 'Kontrollér din e-mail og vælg en adgangskode på mindst otte tegn.',
	'signin-error': 'Vi kunne ikke logge dig ind. Kontrollér e-mail og adgangskode.',
	'callback-error': 'Loginlinket kunne ikke bekræftes. Bed om et nyt link.',
	required: 'Log ind for at fortsætte.',
};
const message = messages[Astro.url.searchParams.get('status') ?? ''];
---

<SiteLayout title="Log ind — LearnAI.nu" description="Log ind på LearnAI." noindex analytics={false} chrome={false}>
	<section class="section auth-section">
		<div class="shell auth-shell">
			<div class="section-intro">
				<p class="eyebrow">LearnAI</p>
				<h1>Log ind</h1>
			</div>
			<div class="auth-panel">
				{message && <p class="notice" role="status">{message}</p>}
				<div class="auth-grid">
					<form method="post" action="/auth/sign-in">
						<h2>Log ind</h2>
						<label>E-mail<input type="email" name="email" autocomplete="email" required /></label>
						<label>Adgangskode<input type="password" name="password" autocomplete="current-password" minlength="8" required /></label>
						<button class="button" type="submit">Log ind</button>
					</form>
				</div>
			</div>
		</div>
	</section>
</SiteLayout>
