---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import QuizPlayer from '../../../../components/QuizPlayer';
import {
	calculateCourseProgress,
	findNextIncompleteLesson,
	sortCourseLessons,
	type CourseLesson,
} from '../../../../lib/learning/progress';
import type { QuizQuestionView, QuizView } from '../../../../lib/quiz/contracts';
import { createServerSupabaseClient } from '../../../../lib/supabase/server';
import '../../../../styles/course-experience.css';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');

interface LessonBlock {
	type: string;
	text?: string;
	items?: string[];
	title?: string;
	label?: string;
	href?: string;
}

function parseBlocks(body: unknown): LessonBlock[] {
	if (!body || typeof body !== 'object' || !('blocks' in body)) return [];
	const blocks = (body as { blocks?: unknown }).blocks;
	if (!Array.isArray(blocks)) return [];

	return blocks.flatMap((block) => {
		if (!block || typeof block !== 'object' || !('type' in block) || typeof block.type !== 'string') return [];
		const value = block as Record<string, unknown>;
		return [{
			type: block.type,
			text: typeof value.text === 'string' ? value.text : undefined,
			items: Array.isArray(value.items) ? value.items.filter((item): item is string => typeof item === 'string') : undefined,
			title: typeof value.title === 'string' ? value.title : undefined,
			label: typeof value.label === 'string' ? value.label : undefined,
			href: typeof value.href === 'string' && value.href.startsWith('/') ? value.href : undefined,
		}];
	});
}

const { courseSlug, lessonSlug } = Astro.params;
const supabase = createServerSupabaseClient(Astro.request, Astro.cookies);
const { data: course, error: courseError } = await supabase
	.from('courses')
	.select('id,title,slug')
	.eq('slug', courseSlug)
	.eq('status', 'published')
	.maybeSingle();

if (courseError || !course) return new Response(null, { status: 404 });

const { data: modules, error: modulesError } = await supabase
	.from('course_modules')
	.select('id,title,sort_order,lessons(id,title,slug,description,body,estimated_minutes,sort_order)')
	.eq('course_id', course.id)
	.order('sort_order');

if (modulesError) return new Response(null, { status: 503, statusText: 'Kursusindholdet kunne ikke hentes' });

const sortedModules = (modules ?? []).map((module) => ({
	...module,
	lessons: [...module.lessons].sort((a, b) => a.sort_order - b.sort_order),
}));
const currentModule = sortedModules.find((module) => module.lessons.some((lesson) => lesson.slug === lessonSlug));
const lesson = currentModule?.lessons.find((item) => item.slug === lessonSlug);

if (!currentModule || !lesson) return new Response(null, { status: 404 });

const courseLessons: CourseLesson[] = sortedModules.flatMap((module) =>
	module.lessons.map((item) => ({
		id: item.id,
		slug: item.slug,
		moduleSortOrder: module.sort_order,
		lessonSortOrder: item.sort_order,
	})),
);
const orderedLessons = sortCourseLessons(courseLessons);
const currentIndex = orderedLessons.findIndex((item) => item.id === lesson.id);
const previousSequentialLesson = currentIndex > 0 ? orderedLessons[currentIndex - 1] : null;
const nextSequentialLesson = currentIndex >= 0 && currentIndex < orderedLessons.length - 1 ? orderedLessons[currentIndex + 1] : null;
const currentModuleIndex = sortedModules.findIndex((module) => module.id === currentModule.id);
const { data: claimsData } = await supabase.auth.getClaims();
const userId = claimsData?.claims?.sub;
let progressLoadError = false;
let completedLessonIds = new Set<string>();
let quizLoadError = false;
let quiz: QuizView | null = null;

if (userId && courseLessons.length > 0) {
	const { data: progressRows, error } = await supabase
		.from('lesson_progress')
		.select('lesson_id,completed')
		.eq('user_id', userId)
		.in('lesson_id', courseLessons.map((item) => item.id));

	progressLoadError = Boolean(error);
	completedLessonIds = new Set(
		(progressRows ?? []).filter((row) => row.completed).map((row) => row.lesson_id),
	);

	const { data: quizData, error: quizError } = await supabase
		.from('quizzes')
		.select('id,title,description,passing_score,max_attempts,quiz_questions(id,type,question,points,sort_order,quiz_options(id,option_text,sort_order))')
		.eq('lesson_id', lesson.id)
		.maybeSingle();

	quizLoadError = Boolean(quizError);
	if (quizData) {
		quiz = {
			id: quizData.id,
			title: quizData.title,
			description: quizData.description,
			passingScore: quizData.passing_score,
			maxAttempts: quizData.max_attempts,
			questions: [...quizData.quiz_questions]
				.sort((a, b) => a.sort_order - b.sort_order)
				.map((question) => ({
					id: question.id,
					type: question.type as QuizQuestionView['type'],
					question: question.question,
					points: question.points,
					options: [...question.quiz_options]
						.sort((a, b) => a.sort_order - b.sort_order)
						.map((option) => ({
							id: option.id,
							optionText: option.option_text,
						})),
				})),
		};
	}
}

const isCompleted = completedLessonIds.has(lesson.id);
const progressPercent = calculateCourseProgress(courseLessons, completedLessonIds);
const nextLesson =
	findNextIncompleteLesson(orderedLessons.slice(currentIndex + 1), completedLessonIds) ??
	findNextIncompleteLesson(orderedLessons.slice(0, currentIndex), completedLessonIds);
const blocks = parseBlocks(lesson.body);
const statusMessages: Record<string, { text: string; error?: boolean }> = {
	'save-error': { text: 'Progressionen kunne ikke gemmes. Prøv igen.', error: true },
	'not-allowed': { text: 'Du har ikke adgang til at gemme progression for denne lektion.', error: true },
};
const statusMessage = statusMessages[Astro.url.searchParams.get('status') ?? ''];
---

<SiteLayout title={`${lesson.title} — ${course.title}`} description={lesson.description ?? `Lektion i ${course.title}.`}>
	<div class="course-lesson-experience">
		<div class="course-lesson-rail">
			<div class="course-lesson-shell">
				<aside class="course-lesson-sidebar">
					<div class="course-lesson-sidebar-head">
						<a href={`/kurser/${course.slug}`}>← Kursusoversigt</a>
						<p>Modul {String(currentModuleIndex + 1).padStart(2, '0')}</p>
						<strong>{currentModule.title}</strong>
					</div>
					<div class="course-lesson-sidebar-progress">
						<div class="course-progress-copy">
							<span>Din progression</span>
							<strong>{userId ? `${progressPercent}%` : '—'}</strong>
						</div>
						<div class="course-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={userId ? progressPercent : 0}>
							<span style={`width: ${userId ? progressPercent : 0}%`}></span>
						</div>
						<small>{userId ? `${completedLessonIds.size} af ${courseLessons.length} lektioner færdige` : 'Log ind for at gemme dine fremskridt'}</small>
					</div>
				</aside>

				<article class="course-lesson-content">
					<p class="course-lesson-position">Lektion {currentIndex + 1} / {orderedLessons.length} · {lesson.estimated_minutes ?? '—'} minutter</p>
					<h1>{lesson.title}</h1>
					{lesson.description && <p class="lesson-lead">{lesson.description}</p>}

					{statusMessage && (
						<p class:list={['notice', { 'notice-error': statusMessage.error }]} role={statusMessage.error ? 'alert' : 'status'}>
							{statusMessage.text}
						</p>
					)}
					{progressLoadError && <p class="notice notice-error" role="alert">Din progression kunne ikke hentes. Prøv at genindlæse siden.</p>}

					<div class="lesson-body">
						{blocks.length ? (
							blocks.map((block) => {
								if (block.type === 'heading' && block.text) return <h2>{block.text}</h2>;
								if (block.type === 'checklist' && block.items?.length) {
									return <ul class="content-checklist">{block.items.map((item) => <li>{item}</li>)}</ul>;
								}
								if (block.type === 'callout' && block.text) return <aside class="content-callout">{block.text}</aside>;
								if (block.type === 'example' && block.text) {
									return (
										<div class="prompt-workbench" data-prompt-workbench>
											<div class="prompt-workbench-head">
												<p class="prompt-workbench-label">Prompt-værksted</p>
												<button class="prompt-copy-button" type="button" data-copy-example>Kopiér prompt</button>
											</div>
											<pre class="content-example" data-copy-source><code>{block.text}</code></pre>
											<p class="prompt-copy-status" data-copy-status aria-live="polite"></p>
										</div>
									);
								}
								if (block.type === 'cta' && block.title && block.text && block.href && block.label) {
									return (
										<aside class="lesson-cta">
											<p class="eyebrow">Dit næste niveau</p>
											<h2>{block.title}</h2>
											<p>{block.text}</p>
											<a class="button" href={block.href}>{block.label}</a>
										</aside>
									);
								}
								if (block.text) return <p>{block.text}</p>;
								return null;
							})
						) : (
							<div class="empty-state">
								<h2>Lektionen er ved at blive gjort klar</h2>
								<p>Der er endnu ikke tilføjet lektionsindhold.</p>
							</div>
						)}
				</div>

					<nav class="course-lesson-nav" aria-label="Navigér mellem lektioner">
						{previousSequentialLesson ? (
							<a href={`/kurser/${course.slug}/lektioner/${previousSequentialLesson.slug}`}>
								<span>← Forrige lektion</span>
								<strong>{currentIndex}. {sortedModules.flatMap((module) => module.lessons).find((item) => item.id === previousSequentialLesson.id)?.title}</strong>
							</a>
						) : <div class="course-lesson-nav-placeholder" aria-hidden="true"></div>}
						{nextSequentialLesson ? (
							<a href={`/kurser/${course.slug}/lektioner/${nextSequentialLesson.slug}`}>
								<span>Næste lektion →</span>
								<strong>{currentIndex + 2}. {sortedModules.flatMap((module) => module.lessons).find((item) => item.id === nextSequentialLesson.id)?.title}</strong>
							</a>
						) : (
							<a href={`/kurser/${course.slug}`}><span>Kurset er gennemført</span><strong>Tilbage til kursusoversigten →</strong></a>
						)}
					</nav>

					<div class="lesson-actions">
					{userId ? (
						isCompleted ? (
							<>
								<span class="completed-badge">✓ Lektionen er færdig</span>
								{nextLesson ? (
									<a class="button" href={`/kurser/${course.slug}/lektioner/${nextLesson.slug}`}>Fortsæt til næste ufærdige →</a>
								) : (
									<a class="button" href={`/kurser/${course.slug}`}>Se dit gennemførte kursus</a>
								)}
							</>
						) : (
							<form method="post" action="/api/progress/complete" data-progress-form>
								<input type="hidden" name="lessonId" value={lesson.id} />
								<input type="hidden" name="courseSlug" value={course.slug} />
								<input type="hidden" name="lessonSlug" value={lesson.slug} />
								<button class="button" type="submit" data-submit-button>
									<span data-button-label>Markér lektion som færdig</span>
									<span class="button-loader" aria-hidden="true"></span>
								</button>
								<p class="form-status" aria-live="polite" data-form-status></p>
							</form>
						)
					) : (
						<div class="login-prompt">
							<p>Log ind for at gemme din progression.</p>
							<a class="button" href="/login">Log ind</a>
						</div>
					)}
					</div>

					{quizLoadError && (
					<p class="notice notice-error quiz-load-error" role="alert">
						Quizzen kunne ikke hentes. Genindlæs siden og prøv igen.
					</p>
				)}
					{quiz && <QuizPlayer quiz={quiz} client:load />}
				</article>
			</div>
		</div>
	</div>

	<script>
		for (const form of document.querySelectorAll<HTMLFormElement>('[data-progress-form]')) {
			form.addEventListener('submit', () => {
				const button = form.querySelector<HTMLButtonElement>('[data-submit-button]');
				const label = form.querySelector<HTMLElement>('[data-button-label]');
				const status = form.querySelector<HTMLElement>('[data-form-status]');
				if (button) button.disabled = true;
				if (label) label.textContent = 'Gemmer progression…';
				if (status) status.textContent = 'Vent et øjeblik, mens vi gemmer.';
			});
		}

		for (const workbench of document.querySelectorAll<HTMLElement>('[data-prompt-workbench]')) {
			const button = workbench.querySelector<HTMLButtonElement>('[data-copy-example]');
			const source = workbench.querySelector<HTMLElement>('[data-copy-source]');
			const status = workbench.querySelector<HTMLElement>('[data-copy-status]');
			button?.addEventListener('click', async () => {
				const prompt = source?.textContent?.trim();
				if (!prompt || !navigator.clipboard) {
					if (status) status.textContent = 'Markér teksten og kopiér den manuelt.';
					return;
				}
				try {
					await navigator.clipboard.writeText(prompt);
					button.textContent = 'Kopieret';
					if (status) status.textContent = 'Prompten er kopieret og klar til dit AI-værktøj.';
					window.setTimeout(() => { button.textContent = 'Kopiér prompt'; }, 2200);
				} catch {
					if (status) status.textContent = 'Markér teksten og kopiér den manuelt.';
				}
			});
		}
	</script>
</SiteLayout>
