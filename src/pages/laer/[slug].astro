---
import '../../styles/article-longform.css';
import ArticleBreadcrumbs from '../../components/article/ArticleBreadcrumbs.astro';
import ArticleFaq from '../../components/article/ArticleFaq.astro';
import ArticleSources from '../../components/article/ArticleSources.astro';
import ArticleToc from '../../components/article/ArticleToc.astro';
import AuthorBio from '../../components/article/AuthorBio.astro';
import ContentBody from '../../components/ContentBody.astro';
import PromptBuilder from '../../components/PromptBuilder';
import RelatedContent from '../../components/article/RelatedContent.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { countWords, estimateReadingMinutes, extractHeadings, parseArticleExtras } from '../../lib/content/article';
import { renderMarkdown } from '../../lib/content/markdown';
import { selectRelatedContent } from '../../lib/content/related';
import { siteAuthor } from '../../lib/navigation/site-nav';
import { parsePromptDefinition } from '../../lib/prompts/contracts';
import { createArticleSchema, createCanonicalUrl, createFaqSchema, type SchemaNode } from '../../lib/seo/schema';
import { createServerSupabaseClient } from '../../lib/supabase/server';

export const prerender = false;

const supabase = createServerSupabaseClient(Astro.request, Astro.cookies);
const { data: item, error } = await supabase
	.from('content_items')
	.select('title,slug,type,excerpt,body,seo_title,seo_description,published_at,updated_at,source_metadata')
	.eq('slug', Astro.params.slug)
	.eq('status', 'published')
	.maybeSingle();

if (error || !item) return new Response('Indholdet blev ikke fundet.', { status: 404 });
const promptDefinition = item.type === 'prompt'
	? parsePromptDefinition(item.source_metadata)
	: null;

const typeLabels = {
	article: 'Artikel',
	guide: 'Guide',
	news: 'Nyhed',
	prompt: 'Prompt',
	tool: 'Værktøj',
} as const;
const typeLabel = typeLabels[item.type as keyof typeof typeLabels] ?? 'Indhold';
const pageDescription = item.seo_description ?? item.excerpt ?? 'Praktisk AI-læring på dansk.';
const canonicalUrl = createCanonicalUrl(Astro.url, Astro.site ? new URL(Astro.site) : Astro.url);
const extras = parseArticleExtras(item.source_metadata);

// Render once here so the table of contents, the reading time and the body all
// describe the same HTML.
const markdown = item.body && typeof item.body === 'object' && 'markdown' in item.body
	&& typeof (item.body as { markdown?: unknown }).markdown === 'string'
	? (item.body as { markdown: string }).markdown
	: '';
const bodyHtml = markdown ? renderMarkdown(markdown, { headingIds: true }) : '';
const headings = extractHeadings(bodyHtml);
const wordCount = countWords(bodyHtml);
const readingMinutes = estimateReadingMinutes(wordCount);
const isLongForm = !promptDefinition && wordCount > 0;

// Related reading: rank the rest of the library against this article.
const { data: candidates } = await supabase
	.from('content_items')
	.select('title,slug,type,excerpt,published_at,updated_at')
	.eq('status', 'published')
	.in('type', ['article', 'guide', 'news'])
	.order('published_at', { ascending: false })
	.limit(40);
const related = selectRelatedContent(
	{ slug: item.slug, title: item.title, type: item.type, keywords: extras.keywords },
	candidates ?? [],
);

const isArticleType = ['article', 'guide', 'news'].includes(item.type);
const articleSchema: SchemaNode | undefined = isArticleType
	? createArticleSchema({
		canonicalUrl,
		type: item.type === 'news' ? 'NewsArticle' : 'Article',
		headline: item.title,
		description: pageDescription,
		datePublished: item.published_at,
		dateModified: item.updated_at,
		articleSection: typeLabel,
		keywords: extras.keywords ?? [],
		image: extras.image ?? null,
		imageAlt: extras.imageAlt ?? null,
		wordCount: wordCount || null,
		readingMinutes: isLongForm ? readingMinutes : null,
		citations: extras.sources ?? [],
		about: extras.about ?? [],
	})
	: undefined;
const faqEntries = extras.faq ?? [];
const additionalSchema = faqEntries.length ? [createFaqSchema(canonicalUrl, faqEntries)] : [];
const publishedLabel = item.published_at
	? new Date(item.published_at).toLocaleDateString('da-DK', { day: 'numeric', month: 'long', year: 'numeric' })
	: null;
---

<SiteLayout
	title={`${item.seo_title ?? item.title} — LearnAI.nu`}
	description={pageDescription}
	ogType={isArticleType ? 'article' : 'website'}
	image={extras.image ?? null}
	imageAlt={extras.imageAlt ?? null}
	publishedTime={item.published_at}
	modifiedTime={item.updated_at}
	articleSection={typeLabel}
	breadcrumbs={[
		{ name: 'Forside', url: '/' },
		{ name: 'Lær AI', url: '/laer' },
		{ name: item.title, url: Astro.url.pathname },
	]}
	mainEntity={articleSchema}
	additionalSchema={additionalSchema}
>
	<article
		class="article-page"
		data-article-reader
		data-reading-minutes={readingMinutes}
	>
		<div class:list={['shell', 'article-reading-layout', { 'has-toc': headings.length >= 3 }]}>
			{isLongForm && <ArticleToc headings={headings} readingMinutes={readingMinutes} />}
		<header class="article-header">
			<ArticleBreadcrumbs items={[
				{ name: 'Forside', url: '/' },
				{ name: 'Lær AI', url: '/laer' },
				{ name: item.title },
			]} />
			<p class="eyebrow">{typeLabel}</p>
			<h1>{item.title}</h1>
			{item.excerpt && <p class="hero-copy">{item.excerpt}</p>}
			<div class="article-meta">
				<span class="article-meta-avatar" aria-hidden="true">{siteAuthor.initials}</span>
				<div>
					<span class="article-meta-author">{siteAuthor.name}</span>
					<span class="article-meta-details">
						{publishedLabel && <time datetime={item.published_at}>{publishedLabel}</time>}
						{isLongForm && <> · {readingMinutes} min. læsning</>}
						{' '}· Opdateret <time datetime={item.updated_at}>{new Date(item.updated_at).toLocaleDateString('da-DK')}</time>
					</span>
				</div>
			</div>
		</header>
		<div class:list={['article-content', { 'has-reading-rail': headings.some((heading) => heading.level === 2) }]}>
			{promptDefinition ? (
				<PromptBuilder client:load definition={promptDefinition} title={item.title} />
			) : (
				<>
					{bodyHtml
						? <div class="article-body" set:html={bodyHtml} />
						: <ContentBody body={item.body} />}
					<ArticleFaq entries={faqEntries} />
					<ArticleSources sources={extras.sources ?? []} />
					<AuthorBio />
					<RelatedContent items={related} />
				</>
			)}
		</div>
		</div>
	</article>
	<script>
		import { initArticleReadingProgress } from '../../scripts/article-reading-progress';
		initArticleReadingProgress();
	</script>
</SiteLayout>
