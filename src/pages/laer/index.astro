---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { createCanonicalUrl, createItemListSchema } from '../../lib/seo/schema';
import { createServerSupabaseClient } from '../../lib/supabase/server';
import '../../styles/knowledge-index.css';

export const prerender = false;

const supabase = createServerSupabaseClient(Astro.request, Astro.cookies);
const selectedType = Astro.url.searchParams.get('type');
const searchQuery = Astro.url.searchParams.get('q')?.trim().slice(0, 120) ?? '';
const supportedTypes = ['article', 'guide', 'news', 'prompt', 'tool'];
let contentQuery = supabase
	.from('content_items')
	.select('id,title,slug,type,excerpt,published_at,updated_at')
	.eq('status', 'published');

if (!selectedType) contentQuery = contentQuery.in('type', ['article', 'guide', 'news']);
else if (selectedType === 'knowledge') contentQuery = contentQuery.in('type', ['article', 'guide']);
else if (selectedType && supportedTypes.includes(selectedType)) contentQuery = contentQuery.eq('type', selectedType);
if (searchQuery) contentQuery = contentQuery.ilike('title', `%${searchQuery.replaceAll('%', '\\%').replaceAll('_', '\\_')}%`);

const { data: items, error } = await contentQuery.order('published_at', { ascending: false });

const typeLabels = {
	article: 'Artikel',
	guide: 'Guide',
	news: 'Nyhed',
	prompt: 'Prompt',
	tool: 'Værktøj',
} as const;
const filters = [
	{ value: '', label: 'Alle', href: '/laer' },
	{ value: 'article', label: 'Artikler', href: '/laer?type=article' },
	{ value: 'guide', label: 'Guides', href: '/laer?type=guide' },
	{ value: 'news', label: 'Nyheder', href: '/laer?type=news' },
] as const;
const viewCopy = {
	article: { title: 'Artikler om AI.', description: 'Forklaringer og perspektiver, der gør udviklingen lettere at forstå.' },
	guide: { title: 'Guides til AI i praksis.', description: 'Trin-for-trin-hjælp til konkrete opgaver og arbejdsgange.' },
	news: { title: 'Nyheder & indsigt.', description: 'Udvalgte AI-nyheder med fokus på, hvad de betyder i praksis.' },
	prompt: { title: 'Prompts til arbejdet.', description: 'Gennemprøvede skabeloner, du kan tilpasse til din opgave.' },
} as const;
const selectedView = selectedType && selectedType in viewCopy
	? viewCopy[selectedType as keyof typeof viewCopy]
	: { title: 'Lær AI i praksis.', description: 'Nyheder, danske guider og artikler, der hjælper dig fra idé til konkret anvendelse.' };
const canonicalUrl = createCanonicalUrl(Astro.url, Astro.site ? new URL(Astro.site) : Astro.url);
const itemList = createItemListSchema(
	canonicalUrl,
	(items ?? []).map((item) => ({ name: item.title, url: `/laer/${item.slug}` })),
);
---

<SiteLayout
	title="Lær AI — LearnAI.nu"
	description="Praktiske danske guides til at forstå og anvende AI."
	pageType="CollectionPage"
	breadcrumbs={[
		{ name: 'Forside', url: '/' },
		{ name: 'Lær AI', url: '/laer' },
	]}
	mainEntity={itemList}
>
	<section class="hero hero-compact">
		<div class="shell section-intro">
			<p class="eyebrow">Vidensportal</p>
			<h1>{searchQuery ? `Søgeresultater for “${searchQuery}”` : selectedView.title}</h1>
			<p class="hero-copy">{searchQuery ? `${items?.length ?? 0} resultater i LearnAI-biblioteket.` : selectedView.description}</p>
		</div>
	</section>
	<nav class="knowledge-filter" aria-label="Filtrér indholdstype">
		<div class="shell knowledge-filter-inner">
			<span class="knowledge-filter-label">Vis</span>
			{filters.map((filter) => (
				<a href={filter.href} aria-current={(selectedType ?? '') === filter.value ? 'page' : undefined}>
					{filter.label}
				</a>
			))}
		</div>
	</nav>
	<section class="section section-tight">
		<div class="shell">
			{error ? (
				<p class="notice notice-error" role="alert">Indholdet kunne ikke hentes lige nu.</p>
			) : items?.length ? (
				<div class="article-grid">
					{items.map((item) => (
						<article class="article-card">
							<div class="course-meta">
								<span>{typeLabels[item.type as keyof typeof typeLabels] ?? 'Indhold'}</span>
								<span>{new Date(item.published_at ?? item.updated_at).toLocaleDateString('da-DK')}</span>
							</div>
							<h2>{item.title}</h2>
							<p>{item.excerpt ?? 'Praktisk AI-læring på dansk.'}</p>
							<a class="text-link" href={`/laer/${item.slug}`}>Læs mere →</a>
						</article>
					))}
				</div>
			) : (
				<div class="empty-state"><h2>Der er ikke noget i denne kategori endnu</h2><p>Vælg en anden kategori, eller kom snart tilbage.</p></div>
			)}
		</div>
	</section>
</SiteLayout>
