---
import HomeAuthor from '../components/marketing/HomeAuthor.astro';
import ThisWeek from '../components/marketing/ThisWeek.astro';
import HeroLearningPreview from '../components/marketing/HeroLearningPreview.astro';
import LearningModel from '../components/marketing/LearningModel.astro';
import OrbitButton from '../components/ui/OrbitButton.astro';
import BlueOrbitLayout from '../layouts/BlueOrbitLayout.astro';
import { ANALYTICS_EVENTS } from '../lib/analytics/events';

export const prerender = true;
---

<BlueOrbitLayout
	title="AI-guides, prompts og praktisk læring på dansk | LearnAI.nu"
	description="Brug AI bedre på arbejdet med danske guides, gennemprøvede prompts og ugens AI-nyheder fra LearnAI.nu."
	pageType="WebPage"
	alternates={[
		{ locale: 'da', path: '/' },
		{ locale: 'en', path: '/en' },
	]}
>
	<HeroLearningPreview />
	<ThisWeek />
	<LearningModel />
	<HomeAuthor />
	<section class="orbit-final-cta">
		<div>
			<p class="orbit-section-kicker">Dit næste skridt</p>
			<h2>Tag én opgave med. Gå herfra med et bedre næste skridt.</h2>
		</div>
		<OrbitButton
			href="/laer?type=prompt"
			size="large"
			arrow
			analyticsEvent={ANALYTICS_EVENTS.primaryCtaClicked}
			analyticsSource="home_final"
			analyticsDetail="prompts"
		>Find en prompt</OrbitButton>
	</section>
</BlueOrbitLayout>
