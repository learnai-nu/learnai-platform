---
import FeaturedCourses from '../components/marketing/FeaturedCourses.astro';
import HeroLearningPreview from '../components/marketing/HeroLearningPreview.astro';
import LearningModel from '../components/marketing/LearningModel.astro';
import OrbitButton from '../components/ui/OrbitButton.astro';
import BlueOrbitLayout from '../layouts/BlueOrbitLayout.astro';

export const prerender = true;
---

<BlueOrbitLayout
	title="LearnAI.nu — Gør AI til en praktisk kompetence"
	description="Praktisk AI-læring på dansk med korte kurser, stærke prompts og konkrete værktøjer til dit arbejdsliv."
>
	<HeroLearningPreview />
	<LearningModel />
	<FeaturedCourses />
	<section class="orbit-final-cta">
		<p class="orbit-section-kicker">Din næste AI-kompetence starter her</p>
		<h2>Gør AI til noget, du kan — ikke bare noget, du har hørt om.</h2>
		<OrbitButton href="/kurser" variant="light" size="large" arrow>Start gratis</OrbitButton>
	</section>
</BlueOrbitLayout>
