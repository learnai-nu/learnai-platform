---
import FeaturedCourses from '../components/marketing/FeaturedCourses.astro';
import HeroLearningPreview from '../components/marketing/HeroLearningPreview.astro';
import LearningModel from '../components/marketing/LearningModel.astro';
import OrbitButton from '../components/ui/OrbitButton.astro';
import BlueOrbitLayout from '../layouts/BlueOrbitLayout.astro';
import { ANALYTICS_EVENTS } from '../lib/analytics/events';

// Rendered on demand so the same URL can answer in HTML or Markdown depending
// on the Accept header (see src/middleware.ts). The response is still cached at
// the edge — per variant, thanks to `Vary: Accept`.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=600, stale-while-revalidate=86400');
---

<BlueOrbitLayout
	title="AI-kurser, prompts og praktisk læring på dansk | LearnAI.nu"
	description="Brug AI bedre på arbejdet med korte danske kurser, gennemprøvede prompts og konkret sparring fra LearnAI.nu."
	pageType="WebPage"
>
	<HeroLearningPreview />
	<LearningModel />
	<FeaturedCourses />
	<section class="orbit-final-cta">
		<div>
			<p class="orbit-section-kicker">Dit næste skridt</p>
			<h2>Tag én opgave med. Gå herfra med et bedre næste skridt.</h2>
		</div>
		<OrbitButton
			href="/kurser/ai-i-praksis-dit-foerste-kursus"
			variant="light"
			size="large"
			arrow
			analyticsEvent={ANALYTICS_EVENTS.courseCtaClicked}
			analyticsSource="home_final"
			analyticsDetail="course_page"
		>Start gratis</OrbitButton>
	</section>
</BlueOrbitLayout>
