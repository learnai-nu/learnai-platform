---
import FeaturedCourses from '../components/marketing/FeaturedCourses.astro';
import HeroLearningPreview from '../components/marketing/HeroLearningPreview.astro';
import LearningModel from '../components/marketing/LearningModel.astro';
import OrbitButton from '../components/ui/OrbitButton.astro';
import BlueOrbitLayout from '../layouts/BlueOrbitLayout.astro';

export const prerender = true;
---

<BlueOrbitLayout
	title="AI-kurser, prompts og praktisk læring på dansk | LearnAI.nu"
	description="Brug AI bedre på arbejdet med korte danske kurser, gennemprøvede prompts og konkret sparring fra LearnAI.nu."
>
	<HeroLearningPreview />
	<LearningModel />
	<FeaturedCourses />
	<section class="orbit-final-cta">
		<div>
			<p class="orbit-section-kicker">Dit næste skridt</p>
			<h2>Brug mindre tid på at følge med. Brug mere tid på at få noget gjort.</h2>
		</div>
		<OrbitButton href="/kurser/ai-i-praksis-dit-foerste-kursus" variant="light" size="large" arrow>Start gratis</OrbitButton>
	</section>
</BlueOrbitLayout>
