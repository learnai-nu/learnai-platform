---
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = true;

export function getStaticPaths() {
	const pages = {
		vaerktoejer: {
			title: 'AI-værktøjer',
			description: 'Find det rigtige AI-værktøj til dit arbejde og dit niveau.',
			kicker: 'Værktøjskatalog',
		},
		nyheder: {
			title: 'AI-nyheder',
			description: 'Dansk overblik over de AI-nyheder, der betyder noget i praksis.',
			kicker: 'Aktuelt',
		},
		virksomheder: {
			title: 'LearnAI for virksomheder',
			description: 'Kompetenceudvikling, læringsforløb og ansvarlig AI-anvendelse.',
			kicker: 'B2B',
		},
		om: {
			title: 'Om LearnAI',
			description: 'Vores ambition er at gøre AI forståelig og anvendelig for alle.',
			kicker: 'Mission',
		},
		privatliv: {
			title: 'Privatliv',
			description: 'Sådan beskytter LearnAI dine oplysninger.',
			kicker: 'Tillid',
		},
		kontakt: {
			title: 'Kontakt',
			description: 'Kontakt LearnAI om læring, partnerskaber eller virksomheder.',
			kicker: 'Skriv til os',
		},
	} as const;

	return Object.entries(pages).map(([slug, page]) => ({
		params: { slug },
		props: page,
	}));
}

const { title, description, kicker } = Astro.props;
const pageTypes = {
	vaerktoejer: 'CollectionPage',
	nyheder: 'CollectionPage',
	virksomheder: 'WebPage',
	om: 'AboutPage',
	privatliv: 'WebPage',
	kontakt: 'ContactPage',
} as const;
const pageType = pageTypes[Astro.params.slug as keyof typeof pageTypes] ?? 'WebPage';
---

<SiteLayout
	title={`${title} — LearnAI.nu`}
	description={description}
	{pageType}
	breadcrumbs={[
		{ name: 'Forside', url: '/' },
		{ name: title, url: Astro.url.pathname },
	]}
>
	<section class="hero">
		<div class="shell section-intro">
			<p class="eyebrow">{kicker}</p>
			<h1>{title}</h1>
			<p class="hero-copy">{description}</p>
			<div class="hero-actions">
				<a class="button" href="/">Tilbage til forsiden</a>
			</div>
		</div>
	</section>
</SiteLayout>
