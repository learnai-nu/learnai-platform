---
import SiteLayout from '../layouts/SiteLayout.astro';

export const prerender = true;

export function getStaticPaths() {
	const pages = {
		nyheder: {
			title: 'AI-nyheder',
			description: 'Dansk overblik over de AI-nyheder, der betyder noget i praksis.',
			kicker: 'Aktuelt',
		},
		om: {
			title: 'Om LearnAI',
			description: 'Vores ambition er at gøre AI forståelig og anvendelig for alle.',
			kicker: 'Mission',
		},
		privatliv: {
			title: 'Privatliv',
			description: 'Sådan beskytter LearnAI dine oplysninger.',
			kicker: 'Tillid',
		},
		kontakt: {
			title: 'Kontakt',
			description: 'Kontakt LearnAI om læring, partnerskaber eller virksomheder.',
			kicker: 'Skriv til os',
		},
	} as const;

	return Object.entries(pages).map(([slug, page]) => ({
		params: { slug },
		props: page,
	}));
}

const { title, description, kicker } = Astro.props;
const isPrivacyPage = Astro.params.slug === 'privatliv';
const pageTypes = {
	vaerktoejer: 'CollectionPage',
	nyheder: 'CollectionPage',
	om: 'AboutPage',
	privatliv: 'WebPage',
	kontakt: 'ContactPage',
} as const;
const pageType = pageTypes[Astro.params.slug as keyof typeof pageTypes] ?? 'WebPage';
---

<SiteLayout
	title={`${title} — LearnAI.nu`}
	description={description}
	{pageType}
	breadcrumbs={[
		{ name: 'Forside', url: '/' },
		{ name: title, url: Astro.url.pathname },
	]}
>
	<section class="hero">
		<div class="shell section-intro">
			<p class="eyebrow">{kicker}</p>
			<h1>{title}</h1>
			<p class="hero-copy">{description}</p>
			<div class="hero-actions">
				<a class="button" href="/">Tilbage til forsiden</a>
			</div>
		</div>
	</section>
	{isPrivacyPage && (
		<section class="section">
			<div class="shell article-body">
				<h2>Besøgsstatistik og ydeevne</h2>
				<p>
					LearnAI bruger Vercel Web Analytics og Vercel Speed Insights til at forstå, hvilke sider der bliver brugt,
					og hvordan de teknisk fungerer. Den måling er cookie-fri og baseret på anonyme, aggregerede datapunkter.
				</p>
				<p>
					Vi bruger desuden Microsoft Clarity til at se, hvordan siderne bruges — heatmaps og anonymiserede
					sessionsoptagelser af klik, scroll og navigation. Clarity sætter cookies i din browser og behandler data
					hos Microsoft. Indtastet tekst maskeres som standard, og optagelserne knyttes ikke til dit navn eller din
					e-mailadresse.
				</p>
				<h2>Dit samtykke til cookies</h2>
				<p>
					Clarity kører først med cookies, når du har sagt ja i cookiebanneret. Siger du nej — eller har du endnu
					ikke svaret — kører Clarity uden cookies, og vi bruger aldrig cookies til annoncering. Dit valg gemmes
					lokalt i din browser og sendes ikke til os.
				</p>
				<p>
					Du kan til enhver tid ændre valget:
					<button type="button" class="link-button" data-consent-reopen>åbn cookieindstillinger</button>.
				</p>
				<p>
					Vi måler blandt andet sidevisninger, henvisningsside, browser- og enhedstype, omtrentlig geografisk region
					samt centrale handlinger som kursusstart, gennemført øvelse og afsendt kontaktformular.
				</p>
				<h2>Det sender vi ikke til analytics</h2>
				<p>
					Navn, e-mailadresse, virksomhedsnavn, bruger-id, formularfelter, svar fra øvelser og indholdet af samtaler
					med AI Mentor indgår ikke i vores analytics-events.
				</p>
			</div>
		</section>
	)}
</SiteLayout>
