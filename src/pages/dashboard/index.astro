---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getContentManagerRole } from '../../lib/auth/admin';
import {
	continueLabel,
	summariseStartedCourses,
	type CourseLesson,
} from '../../lib/learning/progress';
import { createServerSupabaseClient } from '../../lib/supabase/server';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');

const supabase = createServerSupabaseClient(Astro.request, Astro.cookies);
const { data: claimsData } = await supabase.auth.getClaims();
const claims = claimsData?.claims;
if (!claims) {
	return new Response(null, {
		status: 302,
		headers: { Location: '/login?status=required', 'Cache-Control': 'private, no-store, max-age=0' },
	});
}

const email = typeof claims.email === 'string' ? claims.email : 'Din profil';
const contentManagerRole = getContentManagerRole(claims);
// Progression lever i lesson_progress, ikke i enrollments. Dashboardet viser
// derfor de kurser, brugeren rent faktisk er begyndt på, med samme tal som
// kursussiden.
const { data: courses, error: coursesError } = await supabase
	.from('courses')
	.select('id,title,slug,course_modules(sort_order,lessons(id,slug,sort_order))')
	.eq('status', 'published');

const courseInputs = (courses ?? []).map((course) => {
	const modules = course.course_modules ?? [];
	const lessons: CourseLesson[] = modules.flatMap((module) =>
		(module.lessons ?? []).map((lesson) => ({
			id: lesson.id,
			slug: lesson.slug,
			moduleSortOrder: module.sort_order,
			lessonSortOrder: lesson.sort_order,
		})),
	);
	return { id: course.id, title: course.title, slug: course.slug, moduleCount: modules.length, lessons };
});

const lessonIds = courseInputs.flatMap((course) => course.lessons.map((lesson) => lesson.id));
const { data: progressRows, error: progressError } = lessonIds.length
	? await supabase
		.from('lesson_progress')
		.select('lesson_id,completed,updated_at')
		.eq('user_id', claims.sub)
		.in('lesson_id', lessonIds)
	: { data: [], error: null };

const startedCourses = summariseStartedCourses(
	courseInputs,
	(progressRows ?? []).map((row) => ({
		lessonId: row.lesson_id,
		completed: Boolean(row.completed),
		updatedAt: row.updated_at ?? null,
	})),
);
const loadFailed = Boolean(coursesError || progressError);
---

<SiteLayout title="Dit dashboard — LearnAI.nu" description="Se din progression og fortsæt dit læringsforløb." noindex>
	<section class="section">
		<div class="shell dashboard-head">
			<div>
				<p class="eyebrow">Dit dashboard</p>
				<h1>Velkommen tilbage.</h1>
				<p class="hero-copy">{email}</p>
			</div>
			<div class="dashboard-actions">
				{contentManagerRole && <a class="button" href="/admin">Åbn admin-CMS</a>}
				<a class="button" href="/mentor">Spørg AI Mentor</a>
				<a class="button button-ghost" href="/dashboard/profil">Læringsprofil</a>
				<form method="post" action="/auth/sign-out"><button class="button button-ghost" type="submit">Log ud</button></form>
			</div>
		</div>
	</section>
	<section class="section section-tight">
		<div class="shell">
			<h2>Dine kurser</h2>
			{loadFailed && <p class="notice notice-error" role="alert">Din progression kunne ikke hentes lige nu. Genindlæs siden.</p>}
			{startedCourses.length ? (
				<div class="course-grid">
					{startedCourses.map((course) => (
						<article class="course-card">
							<p class="course-meta">{course.percent === 100 ? 'Gennemført' : 'I gang'}</p>
							<h3>{course.title}</h3>
							<p class="muted-copy">{course.moduleCount} moduler · {course.lessonCount} lektioner</p>
							<div class="course-progress-copy">
								<span>Din progression</span>
								<strong>{course.percent}%</strong>
							</div>
							<div
								class="course-progress-track"
								role="progressbar"
								aria-valuemin="0"
								aria-valuemax="100"
								aria-valuenow={course.percent}
								aria-label={`Progression i ${course.title}`}
							>
								<span style={`width: ${course.percent}%`}></span>
							</div>
							<a
								class="text-link"
								href={course.continueSlug
									? `/kurser/${course.slug}/lektioner/${course.continueSlug}`
									: `/kurser/${course.slug}`}
							>
								{continueLabel(course.percent)} →
							</a>
						</article>
					))}
				</div>
			) : (
				<div class="empty-state">
					<h3>Du er klar til dit første kursus</h3>
					<p>Vælg et gratis forløb og begynd, når det passer dig.</p>
					<a class="button" href="/kurser">Find et kursus</a>
				</div>
			)}
		</div>
	</section>
</SiteLayout>
