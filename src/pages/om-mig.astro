---
/**
 * Personal presentation of the person behind LearnAI.
 *
 * Lives on LearnAI rather than only on jesperschneider.dk, so a reader who
 * wants to know who is teaching can check it without leaving the site — and
 * the page ends in the learning paths instead of an exit link.
 */
import BlueOrbitLayout from '../layouts/BlueOrbitLayout.astro';
import { ANALYTICS_EVENTS } from '../lib/analytics/events';
import { siteAuthor } from '../lib/navigation/site-nav';
import '../styles/about-me.css';

export const prerender = true;

const focusAreas = [
	{
		title: 'AI i hverdagen',
		body: 'Hvordan AI bliver et redskab i det arbejde, man allerede laver — ikke et mål i sig selv.',
	},
	{
		title: 'Værktøjer, der sparer tid',
		body: 'Konkrete værktøjer og arbejdsgange, der frigør tid til det, der betyder noget.',
	},
	{
		title: 'Adoption mellem mennesker',
		body: 'Ny teknologi slår først igennem, når folk hjælper hinanden i gang.',
	},
	{
		title: 'Læring og vidensdeling',
		body: 'Viden, der er let at bruge, så AI bliver brugt bredt og ikke kun af de nysgerrige.',
	},
];

const nextSteps = [
	{
		kicker: 'Gratis skabeloner',
		title: 'Promptbiblioteket',
		body: 'Gennemprøvede prompts, du kan tilpasse til dine egne opgaver.',
		href: '/laer?type=prompt',
		cta: 'Find en prompt',
	},
	{
		kicker: 'Hver mandag',
		title: 'Ugebrief',
		body: 'Ugens vigtigste AI-nyt, skåret ned til det, du faktisk skal vide.',
		href: '/ugebrief',
		cta: 'Få ugebrevet',
	},
	{
		kicker: 'Ca. 7 minutter',
		title: 'Podcast',
		body: 'Samme overblik som lyd — til turen på arbejde.',
		href: '/podcast',
		cta: 'Lyt med',
	},
];
---

<BlueOrbitLayout
	title="Om Jesper Gunris Schneider | LearnAI.nu"
	description="Jesper Gunris Schneider står bag LearnAI. Chef for digital forretningsudvikling med ansvar for AI-strategi og bred brug af AI i praksis."
	pageType="AboutPage"
	breadcrumbs={[
		{ name: 'Forside', url: '/' },
		{ name: 'Om mig', url: '/om-mig' },
	]}
	mainEntity={{ '@type': 'Person', '@id': 'https://learnai.nu/#person' }}
>
	<section class="about-hero">
		<div class="about-hero-copy">
			<p class="orbit-eyebrow">Om mig</p>
			<h1>Jeg hjælper folk med at bruge AI <em>i det arbejde, de allerede laver.</em></h1>
			<p class="about-lead">
				Jeg hedder <strong>Jesper Gunris Schneider</strong> og står bag LearnAI. Til daglig er jeg chef for
				digital forretningsudvikling med ansvar for AI-strategi — og for, at teknologien rent faktisk
				bliver brugt bredt.
			</p>
		</div>
		<figure class="about-portrait">
			<img
				class="about-photo"
				src="/om/portraet-placeholder-stor.svg"
				alt=""
				width="720"
				height="766"
				fetchpriority="high"
				decoding="async"
			/>
			<figcaption>
				<strong>{siteAuthor.name}</strong>
				<span>Chef for digital forretningsudvikling</span>
			</figcaption>
		</figure>
	</section>

	<section class="about-section about-story" aria-labelledby="about-story-title">
		<div class="about-story-heading">
			<p class="orbit-section-kicker">Baggrund</p>
			<h2 id="about-story-title">Fra digital handel til AI-transformation</h2>
		</div>
		<div class="about-story-body">
			<p>
				Jeg har arbejdet med digital forretning i mere end 25 år: e-commerce, telecom og nu
				AI-transformation. Meget af tiden med digitalt salg og marketing, hvor man hurtigt lærer, at
				teknologi kun er værd noget, når kunderne og kollegerne faktisk bruger den.
			</p>
			<p>
				I dag leder jeg et tværfagligt digitalt team i krydsfeltet mellem teknologi, mennesker og
				forretning. Min opgave er ikke at finde den nyeste model — det er at få AI til at gøre en
				mærkbar forskel i det arbejde, folk allerede laver.
			</p>
			<blockquote>
				Jeg ser AI som et redskab til at styrke beslutninger, effektivisere processer og skabe bedre
				oplevelser — ikke som et mål i sig selv.
			</blockquote>
		</div>
	</section>

	<section class="about-section" aria-labelledby="about-work-title">
		<div class="about-section-heading">
			<p class="orbit-section-kicker">Det optager mig</p>
			<h2 id="about-work-title">Fra strategi til noget, der bliver brugt</h2>
		</div>
		<ol class="about-focus">
			{focusAreas.map((area, index) => (
				<li>
					<span class="about-focus-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
					<h3>{area.title}</h3>
					<p>{area.body}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="about-section about-why" aria-labelledby="about-why-title">
		<p class="orbit-section-kicker">Hvorfor LearnAI</p>
		<h2 id="about-why-title">Fordi de fleste ikke mangler værktøjer. De mangler et godt første skridt.</h2>
		<p>
			I mit eget arbejde ser jeg det samme igen og igen: Folk er nysgerrige, men ved ikke, hvor de skal
			starte, og det meste indhold om AI handler om teknologien i stedet for opgaven. LearnAI er mit bud
			på det modsatte — praktiske danske guides, gennemprøvede prompts og et ugentligt overblik, der starter
			med det, du skal have lavet.
		</p>
		<p class="about-principle">Start med opgaven. Brug kun den AI-viden, der bringer arbejdet videre.</p>
	</section>

	<section class="about-section" aria-labelledby="about-next-title">
		<div class="about-section-heading">
			<p class="orbit-section-kicker">Kom i gang</p>
			<h2 id="about-next-title">Her kan du starte</h2>
		</div>
		<div class="about-next">
			{nextSteps.map((step, index) => (
				<a
					class:list={['about-next-card', { 'about-next-card-primary': index === 0 }]}
					href={step.href}
					data-analytics-event={index === 0 ? ANALYTICS_EVENTS.primaryCtaClicked : undefined}
					data-analytics-source={index === 0 ? 'about_me' : undefined}
					data-analytics-detail={index === 0 ? 'prompts' : undefined}
				>
					<span class="about-next-kicker">{step.kicker}</span>
					<h3>{step.title}</h3>
					<p>{step.body}</p>
					<strong>{step.cta} <b aria-hidden="true">→</b></strong>
				</a>
			))}
		</div>
	</section>

	<section class="about-contact" aria-labelledby="about-contact-title">
		<div>
			<p class="orbit-section-kicker">Kontakt</p>
			<h2 id="about-contact-title">Lad os holde kontakten</h2>
			<p>Følg med på LinkedIn, eller læs mere om mig på jesperschneider.dk.</p>
		</div>
		<div class="about-contact-actions">
			<p class="about-elsewhere">
				<a href="https://www.linkedin.com/in/jesperschneider/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
				<a href="https://jesperschneider.dk/" target="_blank" rel="noopener noreferrer">jesperschneider.dk <span aria-hidden="true">↗</span></a>
			</p>
		</div>
	</section>
</BlueOrbitLayout>
