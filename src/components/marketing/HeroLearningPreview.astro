---
import OrbitButton from '../ui/OrbitButton.astro';
---

<section class="orbit-hero">
	<div class="orbit-aurora orbit-aurora-one"></div>
	<div class="orbit-hero-copy">
		<p class="orbit-eyebrow"><span></span>Praktisk AI-læring · på dansk</p>
		<h1>Bliv bedre til AI.<br /><span>Én praktisk sejr ad gangen.</span></h1>
		<p class="orbit-hero-lead">
			Korte læringsforløb, stærke prompts og konkret vejledning, der gør AI
			til en reel kompetence i dit arbejdsliv.
		</p>
		<div class="orbit-hero-actions">
			<OrbitButton href="/kurser" size="large" arrow>Find dit første kursus</OrbitButton>
			<OrbitButton href="#saadan-virker-det" variant="text" size="large">Se hvordan det virker</OrbitButton>
		</div>
		<p class="orbit-proof-line">Første kursus på under én time</p>
	</div>

	<div class="orbit-hero-stage" aria-label="Eksempel på personligt læringsdashboard">
		<div class="orbit-ring orbit-ring-large"></div>
		<div class="orbit-product-window">
			<div class="orbit-window-bar">
				<strong><span class="orbit-mini-mark">L</span> Mit læringsrum</strong>
				<span class="orbit-avatar">JS</span>
			</div>
			<div class="orbit-window-body">
				<div class="orbit-goal-card">
					<div><small>Ugens mål</small><strong>3 af 4 lektioner</strong></div>
					<div class="orbit-progress-ring" aria-label="75 procent gennemført"><span>75%</span></div>
				</div>
				<div class="orbit-continue-card">
					<span class="orbit-lesson-icon">◇</span>
					<div><small>Fortsæt hvor du slap</small><strong>Skriv prompts, der virker</strong><span>Modul 2 · 8 minutter</span></div>
					<span class="orbit-next-arrow" aria-hidden="true">›</span>
				</div>
			</div>
		</div>
	</div>
</section>
