---
import OrbitButton from '../ui/OrbitButton.astro';
import { ANALYTICS_EVENTS } from '../../lib/analytics/events';
---

<section class="orbit-hero">
	<div class="orbit-hero-copy">
		<p class="orbit-eyebrow">AI til dit arbejde</p>
		<h1>Få AI til at fungere <em>i dit arbejde.</em></h1>
		<p class="orbit-hero-lead">
			Korte kurser, brugbare prompts og konkret sparring på dansk.
			Uden hype og unødvendig teknik.
		</p>
		<div class="orbit-hero-actions">
			<OrbitButton
				href="/kurser/ai-i-praksis-dit-foerste-kursus"
				size="large"
				arrow
				analyticsEvent={ANALYTICS_EVENTS.courseCtaClicked}
				analyticsSource="home_hero"
				analyticsDetail="course_page"
			>Start gratis</OrbitButton>
			<OrbitButton href="/laer?type=prompt" variant="text" size="large">Find en prompt</OrbitButton>
		</div>
		<p class="orbit-proof-line">Første kursus tager under én time</p>
	</div>

	<div class="orbit-hero-stage">
		<form class="task-card" action="/search" method="get" role="search" aria-labelledby="task-card-title">
			<p class="task-card-kicker">Prøv med din egen opgave</p>
			<h2 id="task-card-title">Hvad vil du have AI til at hjælpe med?</h2>
			<label class="sr-only" for="task-query">Skriv et emne eller en opgave</label>
			<div class="task-field">
				<input
					id="task-query"
					type="search"
					name="q"
					required
					minlength="2"
					maxlength="120"
					autocomplete="off"
					enterkeyhint="search"
					placeholder="Fx mødereferat, e-mail eller Excel"
				/>
				<button type="submit" aria-label="Find hjælp til opgaven">
					<span>Find hjælp</span>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</button>
			</div>
			<p class="task-hint">Vi finder kurser, prompts og guides, der passer.</p>
			<div class="task-suggestions">
				<p>Eller start med</p>
				<ul>
					<li><a href="/laer?type=prompt">Skriv et bedre udkast</a></li>
					<li><a href="/laer?type=prompt">Analysér et dokument</a></li>
					<li><a href="/mentor">Forbered et møde</a></li>
				</ul>
			</div>
		</form>
	</div>
</section>

<aside class="orbit-principle" aria-label="LearnAI's princip">
	<p>Start med opgaven. Brug kun den AI-viden, der bringer arbejdet videre.</p>
</aside>
