---
import OrbitBrand from '../ui/OrbitBrand.astro';

const navigation = [
	{ href: '/laer', label: 'Lær AI' },
	{ href: '/kurser', label: 'Kurser' },
	{ href: '/virksomheder', label: 'Virksomheder' },
];
const isActive = (href: string) =>
	Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
---

<header class="orbit-header">
	<div class="orbit-header-inner">
		<OrbitBrand />
		<nav class="orbit-desktop-nav" aria-label="Primær navigation">
			{navigation.map((item) => (
				<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
			))}
		</nav>
		<div class="orbit-header-actions">
			<a class="orbit-login-link" href="/login">Log ind</a>
			<a class="orbit-header-cta" href="/kurser">Kom i gang</a>
		</div>
		<details class="orbit-mobile-nav">
			<summary aria-label="Åbn menu">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			</summary>
			<nav aria-label="Mobil navigation">
				{navigation.map((item) => (
					<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
				))}
				<a href="/login">Log ind</a>
				<a class="orbit-mobile-cta" href="/kurser">Kom i gang</a>
			</nav>
		</details>
	</div>
</header>

<script>
	const mobileDetails = document.querySelector<HTMLDetailsElement>('.orbit-mobile-nav');
	const mobileSummary = mobileDetails?.querySelector<HTMLElement>('summary');
	mobileDetails?.addEventListener('toggle', () => {
		mobileSummary?.setAttribute('aria-label', mobileDetails.open ? 'Luk menu' : 'Åbn menu');
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && mobileDetails?.open) {
			mobileDetails.open = false;
			mobileSummary?.focus();
		}
	});
</script>
