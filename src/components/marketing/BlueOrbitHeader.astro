---
import OrbitBrand from '../ui/OrbitBrand.astro';

const navigation = [
	{ href: '/kurser', label: 'Kurser', section: '/kurser' },
	{ href: '/laer?type=prompt', label: 'Prompts', section: '/laer', type: 'prompt' },
	{ href: '/laer', label: 'Viden', section: '/laer', type: 'all' },
	{ href: '/mentor', label: 'AI Mentor', section: '/mentor' },
];
const isActive = (item: (typeof navigation)[number]) => {
	const inSection = Astro.url.pathname === item.section || Astro.url.pathname.startsWith(`${item.section}/`);
	if (!inSection) return false;
	if (item.type === 'prompt') return Astro.url.searchParams.get('type') === 'prompt';
	if (item.type === 'all') return Astro.url.searchParams.get('type') !== 'prompt';
	return true;
};
---

<header class="orbit-header">
	<div class="orbit-header-inner">
		<OrbitBrand />
		<nav class="orbit-desktop-nav" aria-label="Primær navigation">
			{navigation.map((item) => (
				<a href={item.href} aria-current={isActive(item) ? 'page' : undefined}>{item.label}</a>
			))}
		</nav>
		<div class="orbit-header-actions">
			<a class="orbit-login-link" href="/login">Log ind</a>
			<a class="orbit-header-cta" href="/kurser/ai-i-praksis-dit-foerste-kursus">Start gratis</a>
		</div>
		<details class="orbit-mobile-nav">
			<summary aria-label="Åbn menu">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			</summary>
			<nav aria-label="Mobil navigation">
				{navigation.map((item) => (
					<a href={item.href} aria-current={isActive(item) ? 'page' : undefined}>{item.label}</a>
				))}
				<a href="/login">Log ind</a>
				<a class="orbit-mobile-cta" href="/kurser/ai-i-praksis-dit-foerste-kursus">Start gratis</a>
			</nav>
		</details>
	</div>
</header>

<script>
	const mobileDetails = document.querySelector<HTMLDetailsElement>('.orbit-mobile-nav');
	const mobileSummary = mobileDetails?.querySelector<HTMLElement>('summary');
	mobileDetails?.addEventListener('toggle', () => {
		mobileSummary?.setAttribute('aria-label', mobileDetails.open ? 'Luk menu' : 'Åbn menu');
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && mobileDetails?.open) {
			mobileDetails.open = false;
			mobileSummary?.focus();
		}
	});
</script>
