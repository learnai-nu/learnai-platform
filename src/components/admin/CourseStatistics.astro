---
import { participantHref } from '../../lib/admin/course-participants';
import type { SupabaseClient } from '@supabase/supabase-js';
import { completionRate, courseStatisticsSchema, totalCourseStatistics } from '../../lib/admin/course-statistics';

interface Props { supabase: SupabaseClient }
const { supabase } = Astro.props;
const { data, error } = await supabase.rpc('admin_course_statistics');
const parsed = courseStatisticsSchema.safeParse(data);
const failed = Boolean(error) || !parsed.success;
const courses = parsed.success ? parsed.data : [];
const total = totalCourseStatistics(courses);
const number = new Intl.NumberFormat('da-DK');
const percent = new Intl.NumberFormat('da-DK', { style: 'percent', maximumFractionDigits: 1 });
function rate(enrolled: number, completed: number) {
	const value = completionRate(enrolled, completed);
	return value === null ? '—' : percent.format(value);
}
---

<section class="admin-panel course-statistics" aria-labelledby="course-statistics-title">
	<div class="admin-panel-head">
		<div><p class="eyebrow">Hele perioden</p><h2 id="course-statistics-title">Kursusstatus</h2></div>
		<a class="text-link" href={participantHref()}>Se deltagere →</a>
	</div>
	{failed ? (
		<p class="notice notice-error" role="alert">Kursusstatistikken kunne ikke hentes. Genindlæs siden eller prøv igen om lidt.</p>
	) : courses.length === 0 ? (
		<p>Der er endnu ingen kurser at vise statistik for.</p>
	) : (
		<>
			<div class="admin-stat-grid">
				<a class="admin-stat" href={participantHref('', 'enrolled')}><span>Tilmeldinger</span><strong>{number.format(total.enrolled)}</strong></a>
				<a class="admin-stat" href={participantHref('', 'in_progress')}><span>I gang</span><strong>{number.format(total.inProgress)}</strong></a>
				<a class="admin-stat" href={participantHref('', 'completed')}><span>Fuldført</span><strong>{number.format(total.completed)}</strong></a>
				<a class="admin-stat" href={participantHref('', 'converted')} aria-label="Se tilmeldte deltagere, der har fuldført"><span>Tilmelding → gennemførsel</span><strong>{rate(total.enrolled, total.completedEnrolled)}</strong></a>
			</div>
			{total.withoutEnrollment > 0 && (
				<p class="notice" role="status">
					{number.format(total.withoutEnrollment)} kursusforløb har fremskridt uden registreret tilmelding.
					De indgår i “I gang” og “Fuldført”, men ikke i konverteringsraten. <a class="text-link" href={participantHref('', 'unregistered')}>Se deltagerne →</a>
				</p>
			)}
			<div class="statistics-table" role="region" aria-label="Kursusstatistik pr. kursus" tabindex="0">
				<table>
					<caption>Status pr. kursus · hele perioden</caption>
					<thead><tr><th scope="col">Kursus</th><th scope="col">Tilmeldte</th><th scope="col">Ikke startet</th><th scope="col">I gang</th><th scope="col">Fuldført</th><th scope="col">Konvertering</th></tr></thead>
					<tbody>{courses.map((course) => (
						<tr>
							<th scope="row"><a class="text-link" href={participantHref(course.id)}>{course.title}</a></th>
							<td><a class="text-link" href={participantHref(course.id, 'enrolled')} aria-label={`Se tilmeldte deltagere på ${course.title}`}>{number.format(course.enrolled)}</a></td><td><a class="text-link" href={participantHref(course.id, 'not_started')} aria-label={`Se ikke-startede deltagere på ${course.title}`}>{number.format(course.notStarted)}</a></td>
							<td><a class="text-link" href={participantHref(course.id, 'in_progress')} aria-label={`Se igangværende deltagere på ${course.title}`}>{number.format(course.inProgress)}</a></td><td><a class="text-link" href={participantHref(course.id, 'completed')} aria-label={`Se fuldførte deltagere på ${course.title}`}>{number.format(course.completed)}</a></td>
							<td><a class="text-link" href={participantHref(course.id, 'converted')} aria-label={`Se tilmeldte, der har fuldført ${course.title}`}>{rate(course.enrolled, course.completedEnrolled)}</a></td>
						</tr>
					))}</tbody>
				</table>
			</div>
			<p class="statistics-definition">
				Tilmeldte er registrerede kursustilmeldinger. I gang er forløb med gemt lektionsfremskridt, som endnu ikke er fuldført.
				Fuldført kræver, at alle kursets nuværende lektioner er markeret færdige.
				Konvertering = fuldførte blandt de tilmeldte ÷ tilmeldte. “—” betyder ingen tilmeldinger.
				Totalerne tæller kursusforløb; samme person kan tælle på flere kurser.
			</p>
		</>
	)}
</section>

<style>
	.course-statistics { margin-bottom: 1.5rem; }
	.statistics-table { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: .9rem; }
	caption { text-align: left; color: var(--muted); padding-bottom: .75rem; }
	th, td { padding: .9rem .75rem; border-bottom: 1px solid var(--line); text-align: right; font-variant-numeric: tabular-nums; }
	thead th { white-space: nowrap; }
	th:first-child { text-align: left; min-width: 14rem; }
	tbody th { font-weight: 600; }
	.statistics-definition { color: var(--muted); font-size: .85rem; line-height: 1.6; margin: 1rem 0 0; }
</style>
