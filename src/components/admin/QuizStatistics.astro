---
import type { SupabaseClient } from '@supabase/supabase-js';
import { quizPassRate, quizStatisticsSchema } from '../../lib/admin/quiz-statistics';

interface Props { supabase: SupabaseClient }
const { supabase } = Astro.props;
const { data, error } = await supabase.rpc('admin_quiz_statistics');
const parsed = quizStatisticsSchema.safeParse(data);
const stats = !error && parsed.success ? parsed.data : null;
const number = new Intl.NumberFormat('da-DK');
const percent = new Intl.NumberFormat('da-DK', { style: 'percent', maximumFractionDigits: 1 });
const formatPercent = (value: number | null) => value === null ? '—' : percent.format(value);
const formatScore = (value: number | null) => formatPercent(value === null ? null : value / 100);
---

<section class="admin-panel quiz-statistics" aria-labelledby="quiz-statistics-title">
	<div class="admin-panel-head">
		<div><p class="eyebrow">Hele perioden</p><h2 id="quiz-statistics-title">Quizstatistik</h2></div>
		<a class="text-link" href="/admin/quizzer">Administrér quizzer →</a>
	</div>
	{!stats ? (
		<p class="notice notice-error" role="alert">Quizstatistikken kunne ikke hentes. Genindlæs siden eller prøv igen om lidt.</p>
	) : stats.quizzes.length === 0 ? (
		<p>Der er endnu ingen quizzer at vise statistik for.</p>
	) : (
		<>
			<div class="admin-stat-grid">
				<div class="admin-stat"><span>Unikke deltagere</span><strong>{number.format(stats.participants)}</strong></div>
				<div class="admin-stat"><span>Afleverede forsøg</span><strong>{number.format(stats.completed)}</strong></div>
				<div class="admin-stat"><span>Beståede forsøg</span><strong>{number.format(stats.passed)}</strong></div>
				<div class="admin-stat"><span>Beståelsesprocent</span><strong>{formatPercent(quizPassRate(stats.completed, stats.passed))}</strong></div>
			</div>
			<p>Gennemsnitlig score på tværs af alle afleverede forsøg: <strong>{formatScore(stats.averageScore)}</strong></p>
			{stats.completed === 0 && <p>Ingen quizforsøg er afleveret endnu.</p>}
			<div class="statistics-table" role="region" aria-label="Resultater pr. quiz" tabindex="0">
				<table>
					<caption>Resultater pr. quiz · hele perioden</caption>
					<thead><tr><th scope="col">Quiz / kursus</th><th scope="col">Deltagere</th><th scope="col">Afleveret</th><th scope="col">Bestået</th><th scope="col">Beståelsesprocent</th><th scope="col">Gns. score</th></tr></thead>
					<tbody>{stats.quizzes.map((quiz) => (
						<tr>
							<th scope="row"><a class="text-link" href={`/admin/quizzer/${quiz.id}`}>{quiz.title}</a><small>{quiz.courseTitle}</small></th>
							<td>{number.format(quiz.participants)}</td><td>{number.format(quiz.completed)}</td><td>{number.format(quiz.passed)}</td>
							<td>{formatPercent(quizPassRate(quiz.completed, quiz.passed))}</td><td>{formatScore(quiz.averageScore)}</td>
						</tr>
					))}</tbody>
				</table>
			</div>
			<p class="statistics-definition">
				Statistikken omfatter afleverede forsøg, inklusive gentagne forsøg. Deltagere tælles én gang samlet og én gang pr. quiz.
				Beståelsesprocent = beståede forsøg ÷ afleverede forsøg. Gennemsnitlig score beregnes over forsøg med en registreret score.
				“—” betyder, at der endnu ikke er et beregningsgrundlag. Ikke-afleverede besvarelser i browseren registreres ikke.
			</p>
		</>
	)}
</section>

<style>
	.quiz-statistics { margin-bottom: 1.5rem; }
	.statistics-table { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: .9rem; }
	caption { text-align: left; color: var(--muted); padding-bottom: .75rem; }
	th, td { padding: .9rem .75rem; border-bottom: 1px solid var(--line); text-align: right; font-variant-numeric: tabular-nums; }
	thead th { white-space: nowrap; }
	th:first-child { text-align: left; min-width: 14rem; }
	tbody th { font-weight: 600; }
	small { display: block; color: var(--muted); margin-top: .3rem; }
	.statistics-definition { color: var(--muted); font-size: .85rem; line-height: 1.6; margin: 1rem 0 0; }
</style>
