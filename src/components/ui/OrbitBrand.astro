---
interface Props {
	light?: boolean;
	compact?: boolean;
}

const { light = false, compact = false } = Astro.props;
---

<a
	class:list={['orbit-brand', { 'orbit-brand-light': light, 'orbit-brand-compact': compact }]}
	href="/"
	aria-label="LearnAI.nu – forside"
>
	<svg class="orbit-brand-symbol" viewBox="0 0 44 44" aria-hidden="true">
		<rect width="44" height="44" rx="14"></rect>
		<path d="M12 14v13.2c0 3 2 4.8 5 4.8h8"></path>
		<path d="m21 27 6-13 6 13M23.5 22h7"></path>
	</svg>
	<span>LearnAI<span>.nu</span></span>
</a>
