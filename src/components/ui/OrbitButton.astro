---
interface Props {
	href: string;
	variant?: 'filled' | 'tonal' | 'light' | 'text';
	size?: 'compact' | 'default' | 'large';
	arrow?: boolean;
}

const {
	href,
	variant = 'filled',
	size = 'default',
	arrow = false,
} = Astro.props;
---

<a class:list={['orbit-button', `orbit-button-${variant}`, `orbit-button-${size}`]} href={href}>
	<slot />
	{arrow && (
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="m9 5 7 7-7 7"></path>
		</svg>
	)}
</a>
