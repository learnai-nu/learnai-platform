---
interface Props {
	href: string;
	variant?: 'filled' | 'tonal' | 'light' | 'text';
	size?: 'compact' | 'default' | 'large';
	arrow?: boolean;
	analyticsEvent?: string;
	analyticsSource?: string;
	analyticsDetail?: string;
}

const {
	href,
	variant = 'filled',
	size = 'default',
	arrow = false,
	analyticsEvent,
	analyticsSource,
	analyticsDetail,
} = Astro.props;
---

<a
	class:list={['orbit-button', `orbit-button-${variant}`, `orbit-button-${size}`]}
	href={href}
	data-analytics-event={analyticsEvent}
	data-analytics-source={analyticsSource}
	data-analytics-detail={analyticsDetail}
>
	<slot />
	{arrow && (
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="m9 5 7 7-7 7"></path>
		</svg>
	)}
</a>
