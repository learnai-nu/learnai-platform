---
import type { ArticleHeading } from '../../lib/content/article';

interface Props {
	headings: ArticleHeading[];
	readingMinutes: number;
}
const { headings, readingMinutes } = Astro.props;
---

{headings.length >= 3 && (
	<details class="article-toc" open>
		<summary>
			<span>Indhold</span>
			<span class="article-toc-time">{readingMinutes} min. læsning</span>
		</summary>
		<nav aria-label="Indholdsfortegnelse">
			<ol>
				{headings.map((heading) => (
					<li class:list={[{ 'is-sub': heading.level === 3 }]}>
						<a href={`#${heading.id}`}>{heading.text}</a>
					</li>
				))}
			</ol>
		</nav>
	</details>
)}
