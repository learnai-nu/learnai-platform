---
import { siteAuthor } from '../../lib/navigation/site-nav';

interface Props { locale?: 'da' | 'en' }
const { locale = 'da' } = Astro.props;
---

<aside class="article-author" aria-label={locale === 'en' ? 'About the author' : 'Om forfatteren'}>
	<span class="article-author-avatar" aria-hidden="true">{siteAuthor.initials}</span>
	<div>
		<span class="article-author-label">{locale === 'en' ? 'Written by' : 'Skrevet af'}</span>
		<p class="article-author-name">{siteAuthor.name}</p>
		<p class="article-author-summary">{siteAuthor.summary}</p>
		<div class="article-author-badges">
			{siteAuthor.credentials.map((credential) => <span>{credential}</span>)}
		</div>
		<a class="text-link" href={siteAuthor.href}>{locale === 'en' ? 'Read more about' : 'Læs mere om'} {siteAuthor.name.split(' ')[0]} →</a>
	</div>
</aside>
