---
interface Props {
	src: string;
	title?: string;
	durationSeconds: number;
	voiceName?: string;
	locale?: 'da' | 'en';
}

const {
	src,
	title,
	durationSeconds,
	voiceName = 'Søren',
	locale = 'da',
} = Astro.props;
const isEnglish = locale === 'en';
const labels = isEnglish
	? {
		eyebrow: 'Listen to the article',
		title: title ?? 'Take the article with you',
		voice: `Narrated by ${voiceName}`,
		play: 'Play',
		pause: 'Pause',
		seek: 'Playback position',
		speed: 'Playback speed',
		download: 'Download MP3',
		error: 'The audio could not be loaded.',
	}
	: {
		eyebrow: 'Lyt til artiklen',
		title: title ?? 'Tag artiklen med dig',
		voice: `Oplæst af ${voiceName}`,
		play: 'Afspil',
		pause: 'Pause',
		seek: 'Afspilningsposition',
		speed: 'Afspilningshastighed',
		download: 'Hent MP3',
		error: 'Lydfilen kunne ikke indlæses.',
	};

function formatDuration(seconds: number) {
	const rounded = Math.max(0, Math.round(seconds));
	return `${Math.floor(rounded / 60)}:${String(rounded % 60).padStart(2, '0')}`;
}
---

<section
	class="article-audio"
	data-article-audio
	data-play-label={labels.play}
	data-pause-label={labels.pause}
	aria-label={labels.eyebrow}
>
	<div class="article-audio-intro">
		<p class="article-audio-eyebrow">{labels.eyebrow}</p>
		<h2>{labels.title}</h2>
		<p>{formatDuration(durationSeconds)} min. · {labels.voice}</p>
	</div>
	<div class="article-audio-controls">
		<button class="article-audio-toggle" type="button" data-audio-toggle aria-label={labels.play}>
			<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 7 8 5-8 5V7Z" /></svg>
			<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 7h3v10H8zm5 0h3v10h-3z" /></svg>
			<span data-audio-toggle-label>{labels.play}</span>
		</button>
		<div class="article-audio-timeline">
			<span data-audio-current>0:00</span>
			<input type="range" min="0" max={durationSeconds} value="0" step="0.1" aria-label={labels.seek} data-audio-progress />
			<span data-audio-duration>{formatDuration(durationSeconds)}</span>
		</div>
		<div class="article-audio-speed" role="group" aria-label={labels.speed}>
			{[1, 1.25, 1.5].map((rate) => (
				<button type="button" class:list={{ 'is-active': rate === 1 }} data-audio-rate={rate} aria-pressed={rate === 1 ? 'true' : 'false'}>{rate}×</button>
			))}
		</div>
	</div>
	<a class="article-audio-download" href={src} download>{labels.download}</a>
	<p class="article-audio-error" data-audio-error hidden>{labels.error}</p>
	<audio src={src} preload="metadata" data-audio-element></audio>
</section>
