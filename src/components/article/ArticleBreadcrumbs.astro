---
/** Visible breadcrumb trail — the schema counterpart lives in SiteLayout. */
interface Props {
	items: { name: string; url?: string }[];
	locale?: 'da' | 'en';
}
const { items, locale = 'da' } = Astro.props;
---

<nav class="article-breadcrumb" aria-label={locale === 'en' ? 'Breadcrumb' : 'Brødkrumme'}>
	{items.map((item, index) => (
		<>
			{index > 0 && <span class="sep" aria-hidden="true">/</span>}
			{item.url ? <a href={item.url}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
		</>
	))}
</nav>
