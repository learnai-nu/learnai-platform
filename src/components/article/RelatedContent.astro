---
import type { RelatedCandidate } from '../../lib/content/related';

interface Props {
	items: RelatedCandidate[];
	heading?: string;
	locale?: 'da' | 'en';
}
const { items, heading, locale = 'da' } = Astro.props;
const resolvedHeading = heading ?? (locale === 'en' ? 'Read next' : 'Læs videre');
const typeLabels: Record<string, string> = locale === 'en'
	? { article: 'Article', guide: 'Guide', news: 'News', prompt: 'Prompt', tool: 'Tool' }
	: { article: 'Artikel', guide: 'Guide', news: 'Nyhed', prompt: 'Prompt', tool: 'Værktøj' };
---

{items.length > 0 && (
	<section class="article-related" aria-labelledby="laes-videre">
		<h2 id="laes-videre">{resolvedHeading}</h2>
		<div class="article-related-grid">
			{items.map((item) => (
				<a class="article-related-card" href={`${locale === 'en' ? '/en/learn' : '/laer'}/${item.slug}`}>
					<span class="article-related-type">{typeLabels[item.type] ?? (locale === 'en' ? 'Content' : 'Indhold')}</span>
					<strong>{item.title}</strong>
					{item.excerpt && <span class="article-related-excerpt">{item.excerpt}</span>}
				</a>
			))}
		</div>
	</section>
)}
