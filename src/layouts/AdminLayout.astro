---
import SiteLayout from './SiteLayout.astro';

interface Props {
	title: string;
	description: string;
	active: 'dashboard' | 'content' | 'courses' | 'participants' | 'quizzes' | 'tools' | 'use-cases' | 'resources' | 'events' | 'knowledgeGraph' | 'leads';
	email: string;
	role: 'admin' | 'editor';
}

const { title, description, active, email, role } = Astro.props;
const links = [
	{ id: 'dashboard', label: 'Overblik', href: '/admin' },
	{ id: 'content', label: 'Indhold', href: '/admin/indhold' },
	{ id: 'courses', label: 'Kurser', href: '/admin/kurser' },
	{ id: 'participants', label: 'Deltagere', href: '/admin/deltagere' },
	{ id: 'quizzes', label: 'Quizzer', href: '/admin/quizzer' },
	{ id: 'tools', label: 'Værktøjer', href: '/admin/vaerktoejer' },
	{ id: 'use-cases', label: 'Use cases', href: '/admin/use-cases' },
	{ id: 'resources', label: 'Ressourcer', href: '/admin/ressourcer' },
	{ id: 'events', label: 'Events', href: '/admin/events' },
	{ id: 'knowledgeGraph', label: 'Vidensgraf', href: '/admin/vidensgraf' },
	{ id: 'leads', label: 'Leads', href: '/admin/leads' },
] as const;
---

<SiteLayout title={`${title} — LearnAI Admin`} description={description} noindex analytics={false}>
	<section class="admin-section">
		<div class="shell admin-shell">
			<aside class="admin-sidebar">
				<div>
					<p class="eyebrow">LearnAI CMS</p>
					<strong>{email}</strong>
					<small>{role === 'admin' ? 'Administrator' : 'Redaktør'}</small>
				</div>
				<nav aria-label="Administration">
					{links.filter((link) => link.id !== 'participants' || role === 'admin').map((link) => (
						<a href={link.href} aria-current={active === link.id ? 'page' : undefined}>
							{link.label}
						</a>
					))}
				</nav>
				<a class="text-link" href="/dashboard">← Til dashboard</a>
			</aside>
			<div class="admin-main">
				<slot />
			</div>
		</div>
	</section>
</SiteLayout>
