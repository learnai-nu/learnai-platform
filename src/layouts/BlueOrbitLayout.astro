---
import SiteLayout from './SiteLayout.astro';
import type { BreadcrumbItem, PageSchemaType, SchemaNode } from '../lib/seo/schema';

interface Props {
	title: string;
	description: string;
	/** Page language. Defaults to Danish via SiteLayout. */
	locale?: 'da' | 'en';
	/** Translations of this page, rendered as hreflang alternates. */
	alternates?: { locale: 'da' | 'en'; path: string }[];
	pageType?: PageSchemaType;
	breadcrumbs?: BreadcrumbItem[];
	mainEntity?: SchemaNode;
}

const { title, description, locale, alternates, pageType, breadcrumbs, mainEntity } = Astro.props;
---

<SiteLayout {title} {description} {locale} {alternates} {pageType} {breadcrumbs} {mainEntity}>
	<slot />
</SiteLayout>
