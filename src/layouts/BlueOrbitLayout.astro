---
import '../styles/blue-orbit-tokens.css';
import '../styles/blue-orbit.css';
import BlueOrbitFooter from '../components/marketing/BlueOrbitFooter.astro';
import BlueOrbitHeader from '../components/marketing/BlueOrbitHeader.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="da">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f7f8ff" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
	</head>
	<body class="blue-orbit">
		<a class="orbit-skip-link" href="#main-content">Gå til indhold</a>
		<BlueOrbitHeader />
		<main id="main-content">
			<slot />
		</main>
		<BlueOrbitFooter />
	</body>
</html>
