---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const {
	title,
	description,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="da">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Gå til indhold</a>
		<header class="site-header">
			<div class="shell header-inner">
				<a class="brand" href="/" aria-label="LearnAI.nu – forside">
					<span class="brand-mark" aria-hidden="true">L</span>
					<span>LearnAI<span class="brand-dot">.</span>nu</span>
				</a>
				<nav aria-label="Primær navigation">
					<a href="/laer">Lær AI</a>
					<a href="/kurser">Kurser</a>
					<a href="/vaerktoejer">Værktøjer</a>
					<a href="/nyheder">Nyheder</a>
					<a href="/virksomheder">Virksomheder</a>
				</nav>
				<a class="button button-small button-ghost" href="/login">Log ind</a>
			</div>
		</header>
		<main id="main-content">
			<slot />
		</main>
		<footer>
			<div class="shell footer-inner">
				<div>
					<a class="brand footer-brand" href="/">LearnAI.nu</a>
					<p>Praktisk AI-læring på dansk.</p>
				</div>
				<div class="footer-links">
					<a href="/om">Om LearnAI</a>
					<a href="/privatliv">Privatliv</a>
					<a href="/kontakt">Kontakt</a>
				</div>
				<p>© {new Date().getFullYear()} LearnAI.nu</p>
			</div>
		</footer>
	</body>
</html>
