---
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/blue-orbit-tokens.css';
import '../styles/blue-orbit.css';
import '../styles/learnai-typography.css';
import BlueOrbitFooter from '../components/marketing/BlueOrbitFooter.astro';
import BlueOrbitHeader from '../components/marketing/BlueOrbitHeader.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import {
	buildSitePageGraph,
	createCanonicalUrl,
	type BreadcrumbItem,
	type PageSchemaType,
	type SchemaNode,
} from '../lib/seo/schema';

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	pageType?: PageSchemaType;
	breadcrumbs?: BreadcrumbItem[];
	mainEntity?: SchemaNode;
	additionalSchema?: SchemaNode[];
}

const {
	title,
	description,
	noindex = false,
	pageType = 'WebPage',
	breadcrumbs = [],
	mainEntity,
	additionalSchema = [],
} = Astro.props;

const canonicalURL = createCanonicalUrl(Astro.url, Astro.site ? new URL(Astro.site) : Astro.url);
const structuredData = noindex ? null : buildSitePageGraph({
	siteUrl: new URL('/', Astro.site ?? canonicalURL),
	canonicalUrl: canonicalURL,
	title,
	description,
	pageType,
	breadcrumbs,
	mainEntity,
	additionalNodes: additionalSchema,
});
---

<!doctype html>
<html lang="da-DK">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f2f4f0" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="da_DK" />
		<meta property="og:site_name" content="LearnAI.nu" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
		{structuredData && <JsonLd data={structuredData} />}
	</head>
	<body class="blue-orbit">
		<a class="orbit-skip-link" href="#main-content">Gå til indhold</a>
		<BlueOrbitHeader />
		<main id="main-content">
			<slot />
		</main>
		<BlueOrbitFooter />
	</body>
</html>
