---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';
import '../styles/blue-orbit-tokens.css';
import '../styles/blue-orbit.css';
import '../styles/learnai-typography.css';
import '../styles/mobile-dock.css';
import '../styles/brand-tokens.css';
import BlueOrbitFooter from '../components/marketing/BlueOrbitFooter.astro';
import BlueOrbitHeader from '../components/marketing/BlueOrbitHeader.astro';
import MobileDock from '../components/marketing/MobileDock.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import {
	buildSitePageGraph,
	createCanonicalUrl,
	type BreadcrumbItem,
	type PageSchemaType,
	type SchemaNode,
} from '../lib/seo/schema';

interface Props {
	title: string;
	description: string;
	/** Page language. Defaults to Danish; the English catalogues pass 'en'. */
	locale?: 'da' | 'en';
	/** Translations of this page, rendered as hreflang alternates. */
	alternates?: { locale: 'da' | 'en'; path: string }[];
	noindex?: boolean;
	/** Social share image, absolute or site-relative. */
	image?: string | null;
	imageAlt?: string | null;
	/** `article` unlocks the Open Graph article timestamps below. */
	ogType?: 'website' | 'article';
	publishedTime?: string | null;
	modifiedTime?: string | null;
	articleSection?: string | null;
	pageType?: PageSchemaType;
	breadcrumbs?: BreadcrumbItem[];
	mainEntity?: SchemaNode;
	additionalSchema?: SchemaNode[];
	/** Disable tracking for administrative or otherwise internal surfaces. */
	analytics?: boolean;
}

const {
	title,
	description,
	locale = 'da',
	alternates = [],
	noindex = false,
	image = null,
	imageAlt = null,
	ogType = 'website',
	publishedTime = null,
	modifiedTime = null,
	articleSection = null,
	pageType = 'WebPage',
	breadcrumbs = [],
	mainEntity,
	additionalSchema = [],
	analytics = true,
} = Astro.props;

const canonicalURL = createCanonicalUrl(Astro.url, Astro.site ? new URL(Astro.site) : Astro.url);
const siteOrigin = Astro.site ? new URL(Astro.site) : new URL('/', canonicalURL);
const shareImage = image ? new URL(image, siteOrigin).toString() : null;
const hreflangs = alternates.map((alternate) => ({
	hreflang: alternate.locale === 'en' ? 'en' : 'da-DK',
	href: new URL(alternate.path, siteOrigin).toString(),
}));
const structuredData = noindex ? null : buildSitePageGraph({
	siteUrl: new URL('/', Astro.site ?? canonicalURL),
	canonicalUrl: canonicalURL,
	title,
	description,
	pageType,
	breadcrumbs,
	mainEntity,
	additionalNodes: additionalSchema,
});
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'da-DK'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5f3ee" />
		<meta
			name="robots"
			content={noindex
				? 'noindex, nofollow'
				: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
		/>
		<link rel="canonical" href={canonicalURL} />
		{hreflangs.map((alternate) => (
			<link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
		))}
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content={locale === 'en' ? 'en' : 'da_DK'} />
		<meta property="og:site_name" content="LearnAI.nu" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		{shareImage && <meta property="og:image" content={shareImage} />}
		{shareImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
		{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
		<meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{shareImage && <meta name="twitter:image" content={shareImage} />}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
		{structuredData && <JsonLd data={structuredData} />}
		{analytics && <Analytics />}
		{analytics && <SpeedInsights />}
		<noscript><style>@media (max-width: 1100px) { .orbit-mobile-nav { display: block; } .mn-bar { display: none; } }</style></noscript>
		<script type="speculationrules" is:inline set:html={JSON.stringify({
			prerender: [{ source: 'document', where: { selector_matches: 'a[href^="/"]' }, eagerness: 'moderate' }],
		})} />
	</head>
	<body class="blue-orbit">
		<a class="orbit-skip-link" href="#main-content">Gå til indhold</a>
		<BlueOrbitHeader {locale} {alternates} />
		<main id="main-content">
			<slot />
		</main>
		<BlueOrbitFooter />
		<MobileDock />
		<script src="../scripts/analytics.ts"></script>
	</body>
</html>
